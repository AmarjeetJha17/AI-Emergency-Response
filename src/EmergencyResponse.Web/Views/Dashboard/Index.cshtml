@model EmergencyResponse.Web.Models.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Emergency Operations Center";
}
<div id="emergencyDashboard" class="er-dashboard" data-selected-incident-id="@Model.SelectedIncidentId">
    <header class="er-page-header">
        <div>
            <div class="er-eyebrow">Operations overview</div>
            <h1>Emergency Operations Center</h1>
            <p class="er-page-subtitle">Monitor incident reports, coordinate resources, and prioritize human review.</p>
            <div class="er-data-status">
                <span id="dashboardConnectionIndicator" class="er-status" role="status" aria-live="polite">Connecting...</span>
                <span id="dashboardLastUpdated">Page data retrieved @DateTime.UtcNow.ToString("dd MMM yyyy HH:mm:ss") UTC</span>
            </div>
            <div id="dashboardRefreshStatus" class="er-data-status" role="status" aria-live="polite" data-state="initial">Live refresh has not yet been verified. Counts below reflect the retrieved data.</div>
        </div>
        <div class="er-page-actions">
            <a asp-controller="Map" asp-action="Index" class="btn btn-outline-primary">Open live map</a>
            <button id="refreshDashboardButton" type="button" class="btn btn-primary">Refresh overview</button>
        </div>
    </header>

    <section class="er-kpi-grid" aria-label="Incident overview">
        <div class="er-panel er-metric er-metric-critical">
            <span class="er-metric-label">Critical incidents</span>
            <strong id="criticalIncidentCount" class="er-metric-value">@Model.Summary.CriticalIncidents</strong>
            <span class="er-metric-note">Critical severity · all reported incidents</span>
        </div>
        <div class="er-panel er-metric er-metric-high">
            <span class="er-metric-label">High-priority incidents</span>
            <strong id="highPriorityIncidentCount" class="er-metric-value">@Model.GridItems.Count(x => x.Priority == "High")</strong>
            <span class="er-metric-note">High priority in the displayed queue (up to 100)</span>
            <span class="er-metric-note">High severity overall: <span id="highIncidentCount">@Model.Summary.HighIncidents</span></span>
        </div>
        <div class="er-panel er-metric">
            <span class="er-metric-label">Active incidents</span>
            <strong id="activeIncidentCount" class="er-metric-value">@Model.Summary.ActiveIncidents</strong>
            <span class="er-metric-note">Excludes closed and rejected reports</span>
        </div>
        <div class="er-panel er-metric">
            <span class="er-metric-label">Unassigned incidents</span>
            <strong id="unassignedIncidentCount" class="er-metric-value">@Model.Summary.UnassignedIncidents</strong>
            <span class="er-metric-note">Reports without a responder assignment</span>
        </div>
    </section>

    <section class="er-panel mb-4" aria-labelledby="operationalReviewHeading">
        <div class="er-section-header"><h2 id="operationalReviewHeading" class="er-section-title">Operational review</h2><p class="small text-muted mb-0">Persisted review queues and alerts. Zero pending items does not confirm that analysis has run.</p></div>
        <div class="er-review-grid">
            <div class="er-review-group"><h3>Human review</h3>
                <div class="er-summary-line"><span>AI review</span><strong id="aiReviewCount">@Model.Summary.AwaitingAIReview</strong></div>
                <div class="er-summary-line"><span>Duplicate review</span><strong id="duplicateReviewCount">@Model.Summary.AwaitingDuplicateReview</strong></div>
                <div class="er-summary-line"><span>Visual review</span><strong id="visualReviewCount">@Model.Summary.AwaitingVisualReview</strong></div>
            </div>
            <div class="er-review-group"><h3>Escalations</h3>
                <div class="er-summary-line"><span>Open Escalation Alerts</span><strong id="openEscalationsCount">@Model.Summary.OpenEscalations</strong></div>
                <div class="er-summary-line"><span>Critical</span><strong id="criticalEscalationsCount">@Model.Summary.CriticalEscalations</strong></div>
                <div class="er-summary-line"><span>Awaiting acknowledgement</span><strong id="unacknowledgedEscalationsCount">@Model.Summary.UnacknowledgedEscalations</strong></div>
            </div>
            <div class="er-review-group"><h3>Situations</h3>
                <a class="er-summary-line" asp-controller="Situations" asp-action="Index" ><span>Open situations</span><strong id="openSituationsCount">@Model.Summary.OpenSituations</strong></a>
                <a class="er-summary-line" asp-controller="Situations" asp-action="Index" asp-route-level="Critical"><span>Critical</span><strong id="criticalSituationsCount">@Model.Summary.CriticalSituations</strong></a>
                <a class="er-summary-line" asp-controller="Situations" asp-action="Index" asp-route-resourceShortage="true"><span>Resource shortage</span><strong id="situationsWithResourceShortageCount">@Model.Summary.SituationsWithResourceShortage</strong></a>
            </div>
            <div class="er-review-group"><h3>Notifications</h3>
                <a class="er-summary-line" asp-controller="Notifications" asp-action="Index" asp-route-status="Unread"><span>Unread alerts</span><strong id="unreadNotificationsCount">@Model.Summary.UnreadNotifications</strong></a>
                <a class="er-summary-line" asp-controller="Notifications" asp-action="Index" asp-route-priority="Critical"><span>Critical</span><strong id="criticalNotificationsCount">@Model.Summary.CriticalNotifications</strong></a>
                <a class="er-summary-line" asp-controller="Notifications" asp-action="Index" asp-route-priority="Urgent"><span>Urgent</span><strong id="urgentNotificationsCount">@Model.Summary.UrgentNotifications</strong></a>
            </div>
        </div>
        <p class="small text-muted px-4 pb-3 mb-0">Notification totals reflect the operational summary; the bell and inbox use your authorized recipient scope.</p>
    </section>

    @if (Model.SelectedIncidentId.HasValue)
    {
        <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div><strong>Incident selected from the map.</strong><div class="small">The matching row is focused when it is present in the current grid page.</div></div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Selection</a>
        </div>
    }
    <section class="card mb-4" aria-labelledby="incidentQueueHeading">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div><h2 id="incidentQueueHeading" class="er-section-title">Active Incident Queue</h2><p class="small text-muted mb-0">Latest 100 reports, including terminal states. Filter Status to focus on active work.</p></div>
            <a asp-controller="Incidents" asp-action="Index" class="btn btn-sm btn-outline-primary">All incidents</a>
        </div>
        <div id="incidentQueueEmpty" class="er-empty-state @(Model.GridItems.Any() ? "d-none" : "")"><strong>No incident reports in this queue.</strong>New reports will appear after a successful refresh.</div>
        <div class="er-grid-region" role="region" aria-label="Incident queue, horizontally scrollable" tabindex="0">
                <ejs-grid id="incidentGrid"
                          dataSource="@Model.GridItems"
                          toolbar="@(new List<string>() { "Search", "ColumnChooser" })"
                          allowPaging="true"
                          allowSorting="true"
                          allowFiltering="true"
                          allowResizing="true"
                          allowReordering="true"
                          showColumnChooser="true"
                          height="500">

                    <e-grid-pageSettings pageSize="10" pageSizes="true">
                    </e-grid-pageSettings>

                    <e-grid-filterSettings type="Menu">
                    </e-grid-filterSettings>

                    <e-grid-columns>

                        <e-grid-column field="IncidentNumber"
                                       headerText="Incident"
                                       width="150"
                                       freeze="Left">
                        </e-grid-column>

                        <e-grid-column field="IncidentType"
                                       headerText="Type"
                                       width="130">
                        </e-grid-column>

                        <e-grid-column field="Title"
                                       headerText="Description"
                                       width="280">
                        </e-grid-column>

                        <e-grid-column field="Severity"
                                       headerText="Severity"
                                       width="130"
                                       template="#severityTemplate"
                                       filter="@(new { type = "CheckBox" })">
                        </e-grid-column>

                        <e-grid-column field="Priority"
                                       headerText="Priority"
                                       width="110"
                                       template="#priorityTemplate"
                                       filter="@(new { type = "CheckBox" })">
                        </e-grid-column>

                        <e-grid-column field="Status"
                                       headerText="Status"
                                       width="140"
                                       filter="@(new { type = "CheckBox" })">
                        </e-grid-column>

                        <e-grid-column field="CreatedAtUtc"
                                       headerText="Created"
                                       type="dateTime"
                                       format="dd-MMM-yyyy HH:mm"
                                       width="180">
                        </e-grid-column>

                        <e-grid-column headerText="Alerts"
                                       width="180"
                                       template="#alertTemplate"
                                       allowSorting="false"
                                       allowFiltering="false">
                        </e-grid-column>

                        <e-grid-column headerText="Actions"
                                       width="110"
                                       template="#incidentActions"
                                       allowSorting="false"
                                       allowFiltering="false">
                        </e-grid-column>

                    </e-grid-columns>

                </ejs-grid>
        </div>
        <p class="er-grid-hint px-4 py-2 mb-0">Search, filter, sort, or choose columns from the toolbar. On smaller screens, scroll within the queue to reach review states and actions.</p>
    </section>
    @* Operational Analytics Section *@
    <div class="row g-4 mt-1">

        <div class="col-xl-5">
            <div class="card h-100">

                <div class="card-header">
                    <h2 class="er-section-title">
                        Incidents by Severity
                    </h2>

                    <div class="small text-muted">
                        Current incident distribution
                    </div>
                </div>

                <div class="card-body">
                    <div id="severityChartEmpty" class="er-empty-state @(Model.SeverityDistribution.Sum(x => x.Value) == 0 ? "" : "d-none")">No incident data available.</div>
                    <ejs-accumulationchart id="severityChart"
                                               height="320"
                                               enableSmartLabels="true">

                            <e-accumulationchart-legendsettings
                                visible="true"
                                position="Bottom">
                            </e-accumulationchart-legendsettings>

                            <e-accumulation-series-collection>

                                <e-accumulation-series
                                    dataSource="@Model.SeverityDistribution"
                                    xName="Label"
                                    yName="Value"
                                    innerRadius="60%"
                                    radius="85%"
                                    type="Pie">
                                </e-accumulation-series>

                            </e-accumulation-series-collection>

                        </ejs-accumulationchart>
                </div>

            </div>
        </div>

        <div class="col-xl-7">
            <div class="card h-100">

                <div class="card-header">
                    <h2 class="er-section-title">
                        Incident Volume
                    </h2>

                    <div class="small text-muted">
                        Daily reports over the last 7 days
                    </div>
                </div>

                <div class="card-body">
                    <div id="incidentTrendEmpty" class="er-empty-state @(Model.IncidentTrend.Sum(x => x.Count) == 0 ? "" : "d-none")">No incidents reported during this period.</div>
                    <ejs-chart id="incidentTrendChart"
                                   height="320">

                            <e-chart-primaryxaxis
                                valueType="DateTime"
                                labelFormat="dd MMM">
                            </e-chart-primaryxaxis>

                            <e-chart-primaryyaxis
                                title="Incidents">
                            </e-chart-primaryyaxis>

                            <e-chart-tooltipsettings
                                enable="true">
                            </e-chart-tooltipsettings>

                            <e-series-collection>

                                <e-series
                                    dataSource="@Model.IncidentTrend"
                                    xName="Date"
                                    yName="Count"
                                    type="Line"
                                    width="3">
                                </e-series>

                            </e-series-collection>

                        </ejs-chart>
                </div>

            </div>
        </div>

    </div>

    <div class="row g-4 mt-1 mb-4">

        <div class="col-xl-6">
            <div class="card h-100">

                <div class="card-header">
                    <h2 class="er-section-title">
                        Review Queue
                    </h2>

                    <div class="small text-muted">
                        Items waiting for human review
                    </div>
                </div>

                <div class="card-body">
                    <div id="reviewQueueEmpty" class="er-empty-state @(Model.ReviewQueue.Sum(x => x.Count) == 0 ? "" : "d-none")">No pending reviews.</div>
                    <ejs-chart id="reviewQueueChart"
                                   height="320">

                            <e-chart-primaryxaxis
                                valueType="Category">
                            </e-chart-primaryxaxis>

                            <e-chart-primaryyaxis
                                title="Pending reviews"
                                minimum="0">
                            </e-chart-primaryyaxis>

                            <e-chart-tooltipsettings
                                enable="true">
                            </e-chart-tooltipsettings>

                            <e-series-collection>

                                <e-series
                                    dataSource="@Model.ReviewQueue"
                                    xName="Category"
                                    yName="Count"
                                    type="Column">
                                </e-series>

                            </e-series-collection>

                        </ejs-chart>
                </div>

            </div>
        </div>

        <div class="col-xl-6">
            <div class="card h-100">

                <div class="card-header">
                    <h2 class="er-section-title">
                        Operational Notes
                    </h2>
                </div>

                <div class="card-body">
                    <div class="d-flex flex-column gap-3">

                        <div>
                            <div class="small text-muted">
                                Active incidents
                            </div>

                            <div class="fs-5 fw-semibold" id="notesActiveCount">
                                @Model.Summary.ActiveIncidents
                            </div>
                        </div>

                        <div>
                            <div class="small text-muted">
                                Unassigned incidents
                            </div>

                            <div class="fs-5 fw-semibold" id="notesUnassignedCount">
                                @Model.Summary.UnassignedIncidents
                            </div>
                        </div>

                        <div>
                            <div class="small text-muted">
                                Pending review items (may overlap)
                            </div>

                            <div class="fs-5 fw-semibold" id="notesPendingReviewCount">
                                @(Model.Summary.AwaitingAIReview
                                + Model.Summary.AwaitingDuplicateReview
                                + Model.Summary.AwaitingVisualReview)
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>


    <section class="card mb-4" aria-labelledby="predictiveHeading">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div><h2 id="predictiveHeading" class="er-section-title">Predictive Outlook</h2><p class="small text-muted mb-0">Advisory forecasts only; operational commands remain human-controlled.</p></div>
            <button id="refreshPredictiveOutlook" type="button" class="btn btn-sm btn-outline-primary">Refresh forecasts</button>
        </div>
        <div class="card-body">
            <div id="predictiveOutlookStatus" class="er-data-status mb-3" role="status" aria-live="polite">Forecast data has not yet been checked.</div>
            <div class="row g-3">
                <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted small">Incident volume next 24h</div><div id="forecastIncidentVolume" class="fs-3 fw-bold">Not checked</div></div></div>
                <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted small">Potential resource shortages</div><div id="forecastShortageCount" class="fs-3 fw-bold">Not checked</div></div></div>
                <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted small">Hotspots with increasing recent activity</div><div id="forecastHotspotCount" class="fs-3 fw-bold">Not checked</div><div class="small text-muted">Report-based trend, not a model forecast</div></div></div>
            </div>
        </div>
    </section>
    @* Grid cell templates *@
    <script id="severityTemplate" type="text/x-template">
        ${if(Severity === 'Critical')}
            <span class="er-severity er-severity-critical">Critical</span>
        ${else if(Severity === 'High')}
            <span class="er-severity er-severity-high">High</span>
        ${else if(Severity === 'Moderate')}
            <span class="er-severity er-severity-moderate">Moderate</span>
        ${else if(Severity === 'Low')}
            <span class="er-severity er-severity-low">Low</span>
        ${else}
            <span class="er-status">Unknown</span>
        ${/if}
    </script>

    <script id="priorityTemplate" type="text/x-template">
        ${if(Priority === 'Critical')}
            <strong class="text-danger">${Priority}</strong>
        ${else if(Priority === 'High')}
            <strong class="text-warning">${Priority}</strong>
        ${else}
            <strong>${Priority}</strong>
        ${/if}
    </script>

    <script id="alertTemplate" type="text/x-template">
        ${if(HasDuplicateCandidates)}
            <span class="er-severity er-review-tag er-review-tag-duplicate me-1" title="Duplicate review required">Duplicate review</span>
        ${/if}
        ${if(HasVisualReview)}
            <span class="er-severity er-review-tag er-review-tag-visual me-1" title="Visual review required">Visual review</span>
        ${/if}
        ${if(RequiresAIReview)}
            <span class="er-severity er-review-tag" title="AI review required">AI review</span>
        ${/if}
    </script>

    <script id="incidentActions" type="text/x-template">
        <div class="btn-group btn-group-sm">
            <a href="${DetailsUrl}" class="btn btn-outline-primary py-0 px-2" aria-label="View incident ${IncidentNumber}">View</a>
            <a href="/Map?incidentId=${Id}" class="btn btn-outline-secondary py-0 px-2" title="View on Map" aria-label="Map incident ${IncidentNumber}">Map</a>
        </div>
    </script>

</div>
@section Scripts {
    <script src="~/js/dashboard-outlook.js" asp-append-version="true"></script>
}
