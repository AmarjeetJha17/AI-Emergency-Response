@model EmergencyResponse.Web.Models.Dashboard.DashboardViewModel
@using EmergencyResponse.Domain.Enums

@{
    ViewData["Title"] = "Emergency Operations Dashboard";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">Emergency Operations Dashboard</h1>
        <p class="text-muted mb-0">Live operational overview of emergency incidents.</p>
    </div>

    @* Primary KPI cards *@
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-start border-danger border-4">
                <div class="card-body">
                    <div class="text-muted small">Critical</div>
                    <div class="display-6 fw-bold text-danger">
                        @Model.Summary.CriticalIncidents
                    </div>
                    <div class="text-muted small mt-1">Incidents</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-start border-warning border-4">
                <div class="card-body">
                    <div class="text-muted small">High</div>
                    <div class="display-6 fw-bold text-warning">
                        @Model.Summary.HighIncidents
                    </div>
                    <div class="text-muted small mt-1">Incidents</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-start border-primary border-4">
                <div class="card-body">
                    <div class="text-muted small">Active</div>
                    <div class="display-6 fw-bold text-primary">
                        @Model.Summary.ActiveIncidents
                    </div>
                    <div class="text-muted small mt-1">Open incidents</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border-start border-secondary border-4">
                <div class="card-body">
                    <div class="text-muted small">Unassigned</div>
                    <div class="display-6 fw-bold">
                        @Model.Summary.UnassignedIncidents
                    </div>
                    <div class="text-muted small mt-1">No responder</div>
                </div>
            </div>
        </div>

    </div>

    @* Review queue cards *@
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm @(Model.Summary.AwaitingAIReview > 0 ? "border-warning" : "")">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 text-warning">&#9888;</div>
                    <div>
                        <div class="text-muted small">Awaiting AI Review</div>
                        <div class="fs-3 fw-bold">@Model.Summary.AwaitingAIReview</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm @(Model.Summary.AwaitingDuplicateReview > 0 ? "border-info" : "")">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 text-info">&#8645;</div>
                    <div>
                        <div class="text-muted small">Awaiting Duplicate Review</div>
                        <div class="fs-3 fw-bold">@Model.Summary.AwaitingDuplicateReview</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm @(Model.Summary.AwaitingVisualReview > 0 ? "border-secondary" : "")">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 text-secondary">&#128247;</div>
                    <div>
                        <div class="text-muted small">Awaiting Visual Review</div>
                        <div class="fs-3 fw-bold">@Model.Summary.AwaitingVisualReview</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @* Recent incident queue table *@
    @if (Model.Incidents.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Recent Incidents</strong>
                <a asp-controller="Incidents" asp-action="Index"
                   class="btn btn-sm btn-outline-secondary">
                    View all
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Number</th>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Severity</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Reported</th>
                            <th>Flags</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Incidents)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Incidents"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="fw-semibold text-decoration-none">
                                        @item.IncidentNumber
                                    </a>
                                </td>
                                <td class="text-truncate" style="max-width:220px">
                                    @item.Title
                                </td>
                                <td>
                                    <span class="text-muted small">@item.IncidentType</span>
                                </td>
                                <td>
                                    @{
                                        var severityClass = item.Severity switch
                                        {
                                            SeverityLevel.Critical => "bg-danger",
                                            SeverityLevel.High     => "bg-warning text-dark",
                                            SeverityLevel.Moderate => "bg-info text-dark",
                                            _                      => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @severityClass">@item.Severity</span>
                                </td>
                                <td>
                                    @{
                                        var priorityClass = item.Priority switch
                                        {
                                            PriorityLevel.Critical => "bg-danger",
                                            PriorityLevel.High     => "bg-warning text-dark",
                                            PriorityLevel.Normal   => "bg-info text-dark",
                                            _                      => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @priorityClass">@item.Priority</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-muted small text-nowrap">
                                    @{
                                        var age = DateTime.UtcNow - item.CreatedAtUtc;
                                        var ageText = age.TotalMinutes < 60
                                            ? $"{(int)age.TotalMinutes}m ago"
                                            : age.TotalHours < 24
                                                ? $"{(int)age.TotalHours}h ago"
                                                : $"{(int)age.TotalDays}d ago";
                                    }
                                    @ageText
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        @if (!item.IsAssigned)
                                        {
                                            <span class="badge bg-secondary" title="Unassigned">U</span>
                                        }
                                        @if (item.RequiresAIReview)
                                        {
                                            <span class="badge bg-warning text-dark" title="AI review required">AI</span>
                                        }
                                        @if (item.HasDuplicateCandidates)
                                        {
                                            <span class="badge bg-info text-dark" title="Duplicate candidates">DUP</span>
                                        }
                                        @if (item.HasVisualReview)
                                        {
                                            <span class="badge bg-primary" title="Visual review required">VIS</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light border text-muted">
            No incidents reported yet.
        </div>
    }

</div>
