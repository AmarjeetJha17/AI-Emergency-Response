@model IReadOnlyList<EmergencyResponse.Application.Notifications.DTOs.NotificationItem>

@{
    ViewData["Title"] = "Notification Center";
    var summary = ViewBag.Summary as EmergencyResponse.Application.Notifications.DTOs.NotificationSummary;
    var selectedPriority = ViewBag.SelectedPriority as string;
    var selectedStatus = ViewBag.SelectedStatus as string;
    var selectedType = ViewBag.SelectedType as string;

    int totalUnread = summary?.TotalUnread ?? Model.Count(x => !x.IsRead);
    int criticalCount = summary?.CriticalUnread ?? Model.Count(x => x.Priority == EmergencyResponse.Domain.Notifications.NotificationPriority.Critical);
    int urgentCount = summary?.UrgentUnread ?? Model.Count(x => x.Priority == EmergencyResponse.Domain.Notifications.NotificationPriority.Urgent);
    int importantCount = summary?.ImportantUnread ?? Model.Count(x => x.Priority == EmergencyResponse.Domain.Notifications.NotificationPriority.Important);
    int totalCount = Model.Count;
}

<div class="container-fluid py-3 er-notifications" id="notificationsCenterPage">
    @Html.AntiForgeryToken()

    <!-- Header -->
    <div class="er-page-header">
        <div class="er-page-heading">
            <div class="er-eyebrow">Recipient-scoped operational updates</div>
            <h1 class="er-page-title">Notification Center</h1>
            @if (ViewBag.ErrorMessage is null)
            {
            <div class="d-flex align-items-center gap-2">
                @if (totalUnread > 0)
                {
                    <span class="badge bg-danger">@totalUnread Unread</span>
                }
                else
                {
                    <span class="badge bg-success">All Caught Up</span>
                }
            </div>
            }
            <p class="er-page-subtitle">Review notifications available to your authorized recipient scope. Opening this page does not mark items as read.</p>
        </div>
        <div class="er-page-actions">
            @if (totalUnread > 0)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="markAllNotificationsRead(event)">
                    <i class="bi bi-check2-all me-1"></i>Mark All Read
                </button>
            }
            <a asp-controller="Situations" asp-action="Index" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-diagram-3 me-1"></i>Situation Center
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm">
                <i class="bi bi-speedometer2 me-1"></i>Dashboard
            </a>
        </div>
    </div>

    @if (ViewBag.ErrorMessage is string loadError)
    {
        <div class="alert alert-warning" role="status"><i class="bi bi-exclamation-triangle me-2"></i>@loadError</div>
    }
    else
    {
    <!-- Quick Stats Cards -->
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-2 mb-3">
        <div class="col">
            <a asp-controller="Notifications" asp-action="Index" asp-route-status="Unread" class="text-decoration-none">
                <div class="card border-0 shadow-sm @(selectedStatus == "Unread" ? "bg-danger text-white" : "bg-white text-dark")">
                    <div class="card-body p-3 text-center">
                        <div class="fs-4 fw-bold">@totalUnread</div>
                        <div class="small @(selectedStatus == "Unread" ? "text-white-50" : "text-muted")">Unread notifications</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Notifications" asp-action="Index" asp-route-priority="Critical" class="text-decoration-none">
                <div class="card border-0 shadow-sm @(selectedPriority == "Critical" ? "bg-danger text-white" : "bg-white text-dark")">
                    <div class="card-body p-3 text-center">
                        <div class="fs-4 fw-bold">@criticalCount</div>
                        <div class="small @(selectedPriority == "Critical" ? "text-white-50" : "text-muted")">Critical unread</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Notifications" asp-action="Index" asp-route-priority="Urgent" class="text-decoration-none">
                <div class="card border-0 shadow-sm @(selectedPriority == "Urgent" ? "bg-warning text-dark" : "bg-white text-dark")">
                    <div class="card-body p-3 text-center">
                        <div class="fs-4 fw-bold">@urgentCount</div>
                        <div class="small text-muted">Urgent unread</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Notifications" asp-action="Index" asp-route-priority="Important" class="text-decoration-none">
                <div class="card border-0 shadow-sm @(selectedPriority == "Important" ? "bg-info text-dark" : "bg-white text-dark")">
                    <div class="card-body p-3 text-center">
                        <div class="fs-4 fw-bold">@importantCount</div>
                        <div class="small @(selectedPriority == "Important" ? "text-dark" : "text-muted")">Important unread</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Notifications" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm @(string.IsNullOrEmpty(selectedPriority) && string.IsNullOrEmpty(selectedStatus) && string.IsNullOrEmpty(selectedType) ? "bg-primary text-white" : "bg-white text-dark")">
                    <div class="card-body p-3 text-center">
                        <div class="fs-4 fw-bold">@totalCount</div>
                        <div class="small @(string.IsNullOrEmpty(selectedPriority) && string.IsNullOrEmpty(selectedStatus) && string.IsNullOrEmpty(selectedType) ? "text-white-50" : "text-muted")">Notifications in this view</div>
                    </div>
                </div>
            </a>
        </div>
    </div>
    }

    <!-- Filter Pills -->
    <form asp-action="Index" method="get" class="er-panel p-3 mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label" for="notificationPriority">Priority</label>
                <select id="notificationPriority" name="priority" class="form-select">
                    <option value="">All priorities</option>
                    @foreach (var value in Enum.GetValues<EmergencyResponse.Domain.Notifications.NotificationPriority>())
                    {
                        <option value="@value" selected="@(selectedPriority == value.ToString())">@value</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label" for="notificationStatus">Read status</label>
                <select id="notificationStatus" name="status" class="form-select">
                    <option value="">All statuses</option>
                    <option value="Unread" selected="@(selectedStatus == "Unread")">Unread</option>
                    <option value="Read" selected="@(selectedStatus == "Read")">Read</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <label class="form-label" for="notificationType">Notification type</label>
                <select id="notificationType" name="type" class="form-select">
                    <option value="">All types</option>
                    @foreach (var value in Enum.GetValues<EmergencyResponse.Domain.Notifications.NotificationType>())
                    {
                        <option value="@value" selected="@(selectedType == value.ToString())">@value</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Apply</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(selectedPriority) || !string.IsNullOrWhiteSpace(selectedStatus) || !string.IsNullOrWhiteSpace(selectedType))
        {
            <p class="small text-muted mb-0 mt-3">Filters active: @(selectedPriority ?? "any priority") · @(selectedStatus ?? "any read status") · @(selectedType ?? "any type")</p>
        }
    </form>

    <!-- Notification Feed -->
    @if (ViewBag.ErrorMessage is not null)
    {
        <div class="er-empty-state er-panel"><strong>Notification list unavailable</strong>Current notification data could not be loaded.</div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0 py-5 text-center">
            <div class="card-body">
                <i class="bi bi-bell-slash text-muted" style="font-size: 3rem;"></i>
                <h5 class="fw-bold mt-3">No Notifications Found</h5>
                <p class="text-muted small mb-3">No notifications match the selected filters.</p>
                <a asp-action="Index" class="btn btn-outline-primary btn-sm">Clear Filters</a>
            </div>
        </div>
    }
    else
    {
        <div class="vstack gap-2" id="notificationFeed">
            @foreach (var item in Model)
            {
                var borderClass = item.Priority switch
                {
                    EmergencyResponse.Domain.Notifications.NotificationPriority.Critical => "border-start border-4 border-danger",
                    EmergencyResponse.Domain.Notifications.NotificationPriority.Urgent => "border-start border-4 border-warning",
                    EmergencyResponse.Domain.Notifications.NotificationPriority.Important => "border-start border-4 border-info",
                    _ => "border-start border-4 border-secondary"
                };

                var badgeClass = item.Priority switch
                {
                    EmergencyResponse.Domain.Notifications.NotificationPriority.Critical => "bg-danger text-white",
                    EmergencyResponse.Domain.Notifications.NotificationPriority.Urgent => "bg-warning text-dark",
                    EmergencyResponse.Domain.Notifications.NotificationPriority.Important => "bg-info text-dark",
                    _ => "bg-secondary text-white"
                };

                var iconClass = item.Type switch
                {
                    EmergencyResponse.Domain.Notifications.NotificationType.EscalationOpened => "bi-lightning-fill text-danger",
                    EmergencyResponse.Domain.Notifications.NotificationType.EscalationAcknowledged => "bi-check2-circle text-info",
                    EmergencyResponse.Domain.Notifications.NotificationType.EscalationResolved => "bi-check-all text-success",
                    EmergencyResponse.Domain.Notifications.NotificationType.SituationCreated => "bi-diagram-3-fill text-primary",
                    EmergencyResponse.Domain.Notifications.NotificationType.SituationExpanded => "bi-diagram-3 text-warning",
                    EmergencyResponse.Domain.Notifications.NotificationType.SituationLevelChanged => "bi-shield-exclamation text-danger",
                    EmergencyResponse.Domain.Notifications.NotificationType.SituationReviewRequired => "bi-person-exclamation text-warning",
                    EmergencyResponse.Domain.Notifications.NotificationType.ResourceShortage => "bi-exclamation-octagon-fill text-danger",
                    EmergencyResponse.Domain.Notifications.NotificationType.ResourceAssignment => "bi-truck text-primary",
                    EmergencyResponse.Domain.Notifications.NotificationType.ResourceStatusChanged => "bi-gear-wide-connected text-secondary",
                    EmergencyResponse.Domain.Notifications.NotificationType.AIReviewRequired => "bi-robot text-warning",
                    EmergencyResponse.Domain.Notifications.NotificationType.DuplicateReviewRequired => "bi-copy text-info",
                    EmergencyResponse.Domain.Notifications.NotificationType.VisualReviewRequired => "bi-camera text-secondary",
                    _ => "bi-bell text-secondary"
                };

                var cardBg = item.IsRead ? "bg-white opacity-75" : "bg-white shadow-sm";
                var linkUrl = (!string.IsNullOrWhiteSpace(item.ActionUrl) && Url.IsLocalUrl(item.ActionUrl) ? item.ActionUrl : null) ?? (item.IncidentId.HasValue ? Url.Action("Details", "Incidents", new { id = item.IncidentId.Value }) :
                                (item.OperationalSituationId.HasValue ? Url.Action("Details", "Situations", new { id = item.OperationalSituationId.Value }) : "#"));

                var linkText = item.IncidentId.HasValue ? "View Incident" :
                               (item.OperationalSituationId.HasValue ? "View Situation" : "View Details");

                <div class="card @borderClass @cardBg p-3" id="notif-row-@item.Id">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi @iconClass fs-4 lh-1 mt-1"></i>
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                    <span class="badge @badgeClass">@item.PriorityName</span>
                                    <span class="badge bg-light text-dark border">@item.TypeName</span>
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Unread</span>
                                    }
                                    <span class="text-muted small">@item.CreatedAtUtc.ToString("MMM dd, yyyy HH:mm") UTC</span>
                                </div>
                                <h6 class="mb-1 fw-bold @(item.IsRead ? "text-secondary" : "text-dark")">@item.Title</h6>
                                <p class="mb-2 text-muted small">@item.Message</p>
                                
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @if (item.IncidentId.HasValue)
                                    {
                                        <a asp-controller="Incidents" asp-action="Details" asp-route-id="@item.IncidentId.Value" class="badge bg-light text-primary text-decoration-none border">
                                            <i class="bi bi-file-earmark-text me-1"></i>Incident Details
                                        </a>
                                    }
                                    @if (item.OperationalSituationId.HasValue)
                                    {
                                        <a asp-controller="Situations" asp-action="Details" asp-route-id="@item.OperationalSituationId.Value" class="badge bg-light text-primary text-decoration-none border">
                                            <i class="bi bi-diagram-3 me-1"></i>Situation Overview
                                        </a>
                                    }
                                    @if (item.IncidentEscalationId.HasValue)
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-lightning me-1"></i>Escalation Active
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 text-nowrap">
                            @if (!string.IsNullOrEmpty(linkUrl) && linkUrl != "#")
                            {
                                <a href="@linkUrl" class="btn btn-sm btn-outline-primary">
                                    @linkText <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            }
                            @if (!item.IsRead)
                            {
                                <button type="button" class="btn btn-sm btn-light border btn-mark-read" onclick="markNotificationRead('@item.Id', event)" title="Mark as read">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
