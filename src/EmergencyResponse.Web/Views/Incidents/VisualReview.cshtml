@model EmergencyResponse.Application.DTOs.Incidents.VisualAnalysisResponse
@using EmergencyResponse.Domain.Enums

@{
    ViewData["Title"] = "Visual Analysis Review";
    var incidentId = ViewBag.IncidentId as Guid?;
    var mediaId = ViewBag.MediaId as Guid?;
    var mediaUrl = ViewBag.MediaUrl as string;
    var incidentNumber = ViewBag.IncidentNumber as string;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Visual Analysis Review</h2>
            <div class="text-muted">@incidentNumber</div>
        </div>

        <a asp-action="Details"
           asp-route-id="@incidentId"
           class="btn btn-outline-secondary">
            Back to Incident
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Evidence Image</strong>
                </div>
                <div class="card-body text-center">
                    <img src="@mediaUrl"
                         alt="Incident evidence"
                         class="img-fluid rounded" />
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>AI Findings</strong>
                    <span class="badge bg-warning text-dark">@Model.Status</span>
                </div>
                <div class="card-body">

                    <p>@Model.SceneDescription</p>

                    <div class="small text-muted mb-3">
                        Confidence: @Model.Confidence.ToString("P0")
                    </div>

                    @if (Model.DetectedHazards.Any())
                    {
                        <div class="mb-3">
                            <strong>Detected Hazards</strong>
                            <div class="mt-2 d-flex flex-wrap gap-2">
                                @foreach (var hazard in Model.DetectedHazards)
                                {
                                    <span class="badge bg-danger">@hazard</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="row g-2">
                        <div class="col-6"><span class="small text-muted">Flooding</span><div>@(Model.FloodingVisible ? "Yes" : "No")</div></div>
                        <div class="col-6"><span class="small text-muted">Road blocked</span><div>@(Model.RoadAppearsBlocked ? "Yes" : "No")</div></div>
                        <div class="col-6"><span class="small text-muted">Fire</span><div>@(Model.FireVisible ? "Yes" : "No")</div></div>
                        <div class="col-6"><span class="small text-muted">Smoke</span><div>@(Model.SmokeVisible ? "Yes" : "No")</div></div>
                        <div class="col-6"><span class="small text-muted">Structural damage</span><div>@(Model.StructuralDamageVisible ? "Yes" : "No")</div></div>
                        <div class="col-6"><span class="small text-muted">People appear trapped</span><div>@(Model.PeopleAppearTrapped ? "Yes" : "No")</div></div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.RecommendedResponse))
                    {
                        <div class="mt-3 p-2 bg-light rounded">
                            <span class="small text-muted">Recommended Response</span>
                            <div>@Model.RecommendedResponse</div>
                        </div>
                    }

                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Operator Decision</strong>
                </div>
                <div class="card-body">
                    <form asp-action="VisualReview"
                          asp-route-id="@incidentId"
                          asp-route-mediaId="@mediaId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Decision Notes</label>
                            <textarea name="Decision"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Describe your review decision..."></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    name="Accepted"
                                    value="true"
                                    class="btn btn-success">
                                Accept Analysis
                            </button>

                            <button type="submit"
                                    name="Accepted"
                                    value="false"
                                    class="btn btn-danger">
                                Reject Analysis
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>

    </div>

</div>
