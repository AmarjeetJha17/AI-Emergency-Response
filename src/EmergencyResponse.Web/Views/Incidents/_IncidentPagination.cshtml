@model EmergencyResponse.Application.DTOs.Common.PagedResult<EmergencyResponse.Application.DTOs.Incidents.IncidentListItem>

@if (Model.TotalPages > 1)
{
    var routes = Context.Request.Query.ToDictionary(pair => pair.Key, pair => pair.Value.ToString());
    routes.Remove("page");
    routes["pageSize"] = Model.PageSize.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var firstPage = Math.Max(1, Model.Page - 2);
    var lastPage = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav class="er-pagination" aria-label="Incident report pages">
        <p class="er-form-hint mb-0">Page @Model.Page of @Model.TotalPages</p>
        <ul class="pagination flex-wrap mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                @if (Model.Page <= 1)
                {
                    <span class="page-link" aria-disabled="true">Previous</span>
                }
                else
                {
                    <a class="page-link" asp-all-route-data="routes" asp-route-page="@(Model.Page - 1)">Previous</a>
                }
            </li>
            @if (firstPage > 1)
            {
                <li class="page-item"><a class="page-link" asp-all-route-data="routes" asp-route-page="1" aria-label="Page 1">1</a></li>
                @if (firstPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link" aria-hidden="true">…</span></li>
                }
            }
            @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                    @if (pageNumber == Model.Page)
                    {
                        <span class="page-link" aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <a class="page-link" asp-all-route-data="routes" asp-route-page="@pageNumber" aria-label="Page @pageNumber">@pageNumber</a>
                    }
                </li>
            }
            @if (lastPage < Model.TotalPages)
            {
                @if (lastPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link" aria-hidden="true">…</span></li>
                }
                <li class="page-item"><a class="page-link" asp-all-route-data="routes" asp-route-page="@Model.TotalPages" aria-label="Page @Model.TotalPages">@Model.TotalPages</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                @if (Model.Page >= Model.TotalPages)
                {
                    <span class="page-link" aria-disabled="true">Next</span>
                }
                else
                {
                    <a class="page-link" asp-all-route-data="routes" asp-route-page="@(Model.Page + 1)">Next</a>
                }
            </li>
        </ul>
    </nav>
}
