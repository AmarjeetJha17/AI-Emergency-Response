@model EmergencyResponse.Application.DTOs.Common.PagedResult<EmergencyResponse.Application.DTOs.Incidents.IncidentListItem>

@{
    ViewData["Title"] = "Incidents";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Incidents</h2>
            <p class="text-muted">
                Emergency incident management
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-danger">
            Report Emergency
        </a>

    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get"
                  class="row g-2">

                <div class="col-md-6">
                    <input name="search"
                           value="@Context.Request.Query["search"]"
                           class="form-control"
                           placeholder="Search incidents..." />
                </div>

                <div class="col-md-3">
                    <select name="severity"
                            class="form-select">

                        <option value="">
                            All Severities
                        </option>

                        <option value="Low">Low</option>
                        <option value="Moderate">Moderate</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>

                    </select>
                </div>

                <div class="col-md-3">
                    <button class="btn btn-primary w-100"
                            type="submit">
                        Search
                    </button>
                </div>

            </form>

        </div>
    </div>

    <div class="card shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead>
                    <tr>
                        <th>Incident</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Severity</th>
                        <th>Priority</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var incident in Model.Items)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @incident.IncidentNumber
                                </strong>

                                <div>
                                    @incident.Title
                                </div>

                                <small class="text-muted">
                                    @incident.City
                                </small>
                            </td>

                            <td>@incident.IncidentType</td>
                            <td>@incident.Status</td>
                            <td>@incident.Severity</td>
                            <td>@incident.Priority</td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@incident.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>