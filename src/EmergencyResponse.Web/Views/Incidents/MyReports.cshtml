@model EmergencyResponse.Application.DTOs.Common.PagedResult<EmergencyResponse.Application.DTOs.Incidents.IncidentListItem>

@{
    ViewData["Title"] = "My Reports";
}

<div class="er-incidents">
    <header class="er-page-header">
        <div>
            <div class="er-eyebrow">Your incident reports</div>
            <h1>My Reports</h1>
            <p class="er-page-subtitle">Track reports you submitted and open their current stored details.</p>
        </div>
        <div class="er-page-actions">
            <a asp-action="Create" class="btn btn-primary">Report Emergency</a>
        </div>
    </header>

    @if (Model is null)
    {
        <div class="er-panel er-empty-state" role="alert"><strong>Reports are unavailable</strong>Try again when the service is available.</div>
    }
    else if (!Model.Items.Any())
    {
        <div class="er-panel er-empty-state">
            <strong>@(Model.TotalCount == 0 ? "No reports yet" : "No reports on this page")</strong>
            <p>@(Model.TotalCount == 0 ? "Reports you submit will appear here. A saved report does not confirm a resource dispatch." : "Return to the first page to view your reports.")</p>
            @if (Model.TotalCount == 0)
            {
                <a asp-action="Create" class="btn btn-primary">Report Emergency</a>
            }
            else
            {
                <a asp-action="MyReports" class="btn btn-outline-primary">First page</a>
            }
        </div>
        <partial name="_IncidentPagination" model="Model" />
    }
    else
    {
        <section class="er-panel" aria-labelledby="myReportsHeading">
            <div class="er-section-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h2 id="myReportsHeading" class="er-section-title">Submitted reports</h2>
                <span class="er-form-hint">@Model.TotalCount reports</span>
            </div>
            <partial name="_IncidentTable" model="Model" />
        </section>
        <partial name="_IncidentPagination" model="Model" />
    }
</div>
