@model EmergencyResponse.Application.DTOs.Incidents.CreateIncidentRequest

@{
    ViewData["Title"] = "Report Emergency";
}

<div class="er-incidents er-report-page">
    <header class="er-page-header">
        <div>
            <div class="er-eyebrow">Incident reporting</div>
            <h1>Report Emergency</h1>
            <p class="er-page-subtitle">Describe what you have observed and where help may be needed. Leave unknown impact counts blank.</p>
        </div>
        <div class="er-page-actions">
            <a asp-action="MyReports" class="btn btn-outline-primary">My Reports</a>
        </div>
    </header>

    <p class="er-form-hint mb-4">Fields marked <span class="er-required" aria-hidden="true">*</span> are required. Reporting here does not confirm dispatch or replace your local emergency contact procedure.</p>

    <form asp-action="Create" method="post" class="er-report-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

        <fieldset class="er-panel er-form-section">
            <legend><span class="er-step-number" aria-hidden="true">1</span> Incident details</legend>
            <p class="er-form-hint">Use a concise title and describe the facts you know. Distinguish observations from uncertain information.</p>
            <div class="row g-4">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label">Incident title <span class="er-required" aria-hidden="true">*</span></label>
                    <input asp-for="Title" class="form-control" required maxlength="200" aria-required="true"
                           aria-describedby="TitleHint TitleError" placeholder="For example: rising water at an underpass" />
                    <div id="TitleHint" class="er-form-hint">Up to 200 characters.</div>
                    <span asp-validation-for="Title" id="TitleError" class="field-validation-error" aria-live="polite"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IncidentTypeId" class="form-label">Incident type <span class="er-required" aria-hidden="true">*</span></label>
                    <select asp-for="IncidentTypeId" class="form-select" required aria-required="true" aria-describedby="IncidentTypeIdError">
                        <option value="">Select incident type</option>
                        @if (ViewBag.IncidentTypes != null)
                        {
                            foreach (var type in ViewBag.IncidentTypes)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="IncidentTypeId" id="IncidentTypeIdError" class="field-validation-error" aria-live="polite"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Description <span class="er-required" aria-hidden="true">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="5" required minlength="10" maxlength="5000"
                              aria-required="true" aria-describedby="DescriptionHint DescriptionError"
                              placeholder="What happened? What hazards are visible? What information is still unknown?"></textarea>
                    <div id="DescriptionHint" class="er-form-hint">10–5,000 characters. Include visible hazards and uncertainty without guessing casualty counts.</div>
                    <span asp-validation-for="Description" id="DescriptionError" class="field-validation-error" aria-live="polite"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="er-panel er-form-section">
            <legend><span class="er-step-number" aria-hidden="true">2</span> Location</legend>
            <p class="er-form-hint" id="CoordinatesHint">Enter decimal coordinates: latitude −90 to 90, longitude −180 to 180. Check the location before submitting.</p>
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Latitude" class="form-label"></label>
                    <input asp-for="Latitude" class="form-control" type="number" step="any" min="-90" max="90"
                           aria-describedby="CoordinatesHint LatitudeError" />
                    <span asp-validation-for="Latitude" id="LatitudeError" class="field-validation-error" aria-live="polite"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Longitude" class="form-label"></label>
                    <input asp-for="Longitude" class="form-control" type="number" step="any" min="-180" max="180"
                           aria-describedby="CoordinatesHint LongitudeError" />
                    <span asp-validation-for="Longitude" id="LongitudeError" class="field-validation-error" aria-live="polite"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" maxlength="500" autocomplete="street-address"
                           aria-describedby="AddressError" placeholder="Street, landmark or nearby junction" />
                    <span asp-validation-for="Address" id="AddressError" class="field-validation-error" aria-live="polite"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" maxlength="100" autocomplete="address-level2" aria-describedby="CityError" />
                    <span asp-validation-for="City" id="CityError" class="field-validation-error" aria-live="polite"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="District" class="form-label"></label>
                    <input asp-for="District" class="form-control" maxlength="100" aria-describedby="DistrictError" />
                    <span asp-validation-for="District" id="DistrictError" class="field-validation-error" aria-live="polite"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="State" class="form-label"></label>
                    <input asp-for="State" class="form-control" maxlength="100" autocomplete="address-level1" aria-describedby="StateError" />
                    <span asp-validation-for="State" id="StateError" class="field-validation-error" aria-live="polite"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="er-panel er-form-section">
            <legend><span class="er-step-number" aria-hidden="true">3</span> Impact</legend>
            <p id="ImpactHint" class="er-form-hint">Optional reported counts. Blank means unknown; enter 0 only when you have evidence that the count is zero.</p>
            <div class="row g-4">
                <div class="col-md-4">
                    <label asp-for="PeopleAffected" class="form-label">People affected</label>
                    <input asp-for="PeopleAffected" class="form-control" type="number" min="0" max="2147483647" step="1"
                           aria-describedby="ImpactHint PeopleAffectedError" />
                    <span asp-validation-for="PeopleAffected" id="PeopleAffectedError" class="field-validation-error" aria-live="polite"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="VehiclesAffected" class="form-label">Vehicles affected</label>
                    <input asp-for="VehiclesAffected" class="form-control" type="number" min="0" max="2147483647" step="1"
                           aria-describedby="ImpactHint VehiclesAffectedError" />
                    <span asp-validation-for="VehiclesAffected" id="VehiclesAffectedError" class="field-validation-error" aria-live="polite"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Casualties" class="form-label"></label>
                    <input asp-for="Casualties" class="form-control" type="number" min="0" max="2147483647" step="1"
                           aria-describedby="ImpactHint CasualtiesError" />
                    <span asp-validation-for="Casualties" id="CasualtiesError" class="field-validation-error" aria-live="polite"></span>
                </div>
            </div>
        </fieldset>

        <div class="er-form-actions">
            <p class="er-form-hint mb-0">Review the information before submitting. Evidence can be uploaded from the saved report.</p>
            <div class="er-page-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Submit Emergency Report</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
