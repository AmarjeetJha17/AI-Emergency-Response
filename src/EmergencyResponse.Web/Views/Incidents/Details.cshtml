@model EmergencyResponse.Application.DTOs.Incidents.IncidentResponse
@using EmergencyResponse.Domain.Enums
@using EmergencyResponse.Application.Predictive
@using EmergencyResponse.Web.Models.Incidents
@using System.Security.Claims
@using EmergencyResponse.Application.Security.Authorization

@{
    ViewData["Title"] = "Incident Details";
    var visualEvidence = ViewBag.VisualEvidence as List<VisualEvidenceViewModel>
        ?? new List<VisualEvidenceViewModel>();
    var escalationPrediction =
        ViewBag.EscalationPrediction as EscalationRiskPrediction;
    var canReviewPrediction = User.IsInRole("Operator") ||
        User.IsInRole("EmergencyAdmin") ||
        User.IsInRole("SystemAdmin");
    var canResolveEscalations = RolePermissions.HasPermission(
        User.FindAll(ClaimTypes.Role).Select(claim => claim.Value), Permissions.EscalationsResolve);
}

<div class="container py-4" data-incident-id="@Model.Id">
    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>@Model.Title</h2>
            <div class="text-muted">
                @Model.IncidentNumber
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>

    </div>

    @* Active Escalation Alerts (Phase 12) *@
    @if (Model.ActiveEscalations != null && Model.ActiveEscalations.Any())
    {
        <div class="mb-4">
            @foreach (var esc in Model.ActiveEscalations)
            {
                var levelBorder = esc.Level switch
                {
                    EscalationLevel.Critical => "border-danger bg-danger-subtle",
                    EscalationLevel.High => "border-warning bg-warning-subtle",
                    EscalationLevel.Elevated => "border-info bg-info-subtle",
                    _ => "border-secondary bg-light"
                };
                var levelBadge = esc.Level switch
                {
                    EscalationLevel.Critical => "bg-danger text-white",
                    EscalationLevel.High => "bg-warning text-dark",
                    EscalationLevel.Elevated => "bg-info text-dark",
                    _ => "bg-secondary text-white"
                };
                var statusBadge = esc.Status switch
                {
                    EscalationStatus.Open => "bg-danger",
                    EscalationStatus.Acknowledged => "bg-primary",
                    _ => "bg-secondary"
                };

                <div class="card shadow-sm border-start border-4 @levelBorder mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-4">&#9888;</span>
                                <div>
                                    <h5 class="mb-0 fw-bold">ESCALATION ALERT: @esc.TypeName</h5>
                                    <div class="small text-muted">Created: @esc.CreatedAtUtc.ToString("dd MMM yyyy HH:mm:ss") UTC</div>
                                </div>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <span class="badge @levelBadge px-2 py-1">@esc.LevelName Priority</span>
                                <span class="badge @statusBadge px-2 py-1">@esc.StatusName</span>
                            </div>
                        </div>

                        <div class="p-3 bg-white rounded border mb-2">
                            <strong>Reason:</strong> @esc.Reason
                            @if (esc.Evidence != null && esc.Evidence.Any())
                            {
                                <ul class="list-unstyled mb-0 mt-2 small text-muted font-monospace bg-light p-2 rounded">
                                    @foreach (var ev in esc.Evidence)
                                    {
                                        <li>&bull; @ev</li>
                                    }
                                </ul>
                            }
                        </div>

                        @if (esc.Status == EscalationStatus.Acknowledged)
                        {
                            <div class="small text-muted mb-2">
                                <i class="bi bi-check-circle text-primary"></i> Acknowledged by <strong>@(esc.AcknowledgedByUserName ?? esc.AcknowledgedByUserId ?? "Operator")</strong> at @esc.AcknowledgedAtUtc?.ToString("HH:mm:ss") UTC
                            </div>
                        }

                        @if (User.IsInRole("Operator") || User.IsInRole("EmergencyAdmin") || User.IsInRole("SystemAdmin"))
                        {
                            <div class="d-flex gap-2 mt-3">
                                @if (esc.Status == EscalationStatus.Open)
                                {
                                    <button type="button" class="btn btn-sm btn-primary" onclick="openEscalationModal('@esc.Id', 'Acknowledge', 'Acknowledge Escalation Alert')">
                                        Acknowledge
                                    </button>
                                }
                                @if (canResolveEscalations)
                                {
                                <button type="button" class="btn btn-sm btn-success" onclick="openEscalationModal('@esc.Id', 'Resolve', 'Resolve Escalation Alert')">
                                    Resolve
                                </button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openEscalationModal('@esc.Id', 'Dismiss', 'Dismiss Escalation Alert')">
                                    Dismiss
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* Operational Situations Membership (Phase 12 Part 3) *@
    @{
        var operationalSituations = ViewBag.OperationalSituations as IEnumerable<EmergencyResponse.Application.Situations.DTOs.OperationalSituationResponse>
            ?? Enumerable.Empty<EmergencyResponse.Application.Situations.DTOs.OperationalSituationResponse>();
    }
    @if (operationalSituations.Any())
    {
        <div class="mb-4">
            @foreach (var sit in operationalSituations)
            {
                var sitBorder = sit.Level switch
                {
                    EmergencyResponse.Domain.Enums.EscalationLevel.Critical => "border-danger bg-danger-subtle",
                    EmergencyResponse.Domain.Enums.EscalationLevel.High => "border-warning bg-warning-subtle",
                    EmergencyResponse.Domain.Enums.EscalationLevel.Elevated => "border-info bg-info-subtle",
                    _ => "border-primary bg-primary-subtle"
                };
                var sitBadge = sit.Level switch
                {
                    EmergencyResponse.Domain.Enums.EscalationLevel.Critical => "bg-danger text-white",
                    EmergencyResponse.Domain.Enums.EscalationLevel.High => "bg-warning text-dark",
                    EmergencyResponse.Domain.Enums.EscalationLevel.Elevated => "bg-info text-dark",
                    _ => "bg-primary text-white"
                };

                <div class="card shadow-sm border-start border-4 @sitBorder mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-4">&#127757;</span>
                                <div>
                                    <div class="text-uppercase small fw-bold text-muted">Part of Operational Situation</div>
                                    <h5 class="mb-0 fw-bold">@sit.SituationNumber: @sit.Title</h5>
                                </div>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <span class="badge @sitBadge px-2 py-1">@sit.LevelName</span>
                                <span class="badge bg-secondary px-2 py-1">@sit.StatusName</span>
                                @if (sit.ResourceShortageDetected)
                                {
                                    <span class="badge bg-danger">Shortage Detected</span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(sit.Summary))
                        {
                            <p class="mb-2 text-muted small">@sit.Summary</p>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                            <div class="small text-muted">
                                <span>Total member incidents: <strong>@sit.IncidentCount</strong></span>
                                @if (sit.PeopleAffected > 0)
                                {
                                    <span class="ms-3">People affected: <strong>@sit.PeopleAffected</strong></span>
                                }
                            </div>
                            <a asp-controller="Situations" asp-action="Details" asp-route-id="@sit.Id" class="btn btn-sm btn-outline-primary">
                                View Situation Command Center &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm">
                <div class="card-body">

                    <h5>Description</h5>

                    <p>
                        @Model.Description
                    </p>

                    <hr />

                    <div class="row">

                        <div class="col-md-6">
                            <strong>Type</strong>
                            <div>@Model.IncidentType</div>
                        </div>

                        <div class="col-md-6">
                            <strong>Status</strong>
                            <div>@Model.Status</div>
                        </div>

                    </div>

                </div>
            </div>

            @* Media upload — available to all authenticated users on non-terminal incidents *@
            @{
                var canUpload = Model.Status is not ("Closed" or "Rejected");
            }
            @if (canUpload)
            {
                <div class="card shadow-sm mt-4">
                    <div class="card-header">
                        <strong>Upload Evidence</strong>
                        <div class="small text-muted">
                            Images (JPEG, PNG, WebP, GIF &mdash; max 10 MB) or videos (max 100 MB)
                        </div>
                    </div>
                    <div class="card-body">

                        <form id="uploadForm"
                              method="post"
                              enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label" for="evidenceFile">
                                    Select file
                                </label>
                                <input class="form-control"
                                       type="file"
                                       id="evidenceFile"
                                       accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime,video/x-msvideo,video/*" />
                                <div class="form-text">
                                    AI will automatically analyse the uploaded media.
                                </div>
                            </div>

                            <button type="button"
                                    class="btn btn-primary"
                                    id="uploadBtn">
                                Upload
                            </button>

                            <div id="uploadStatus" class="mt-2 small"></div>
                        </form>

                    </div>
                </div>
            }

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h5 class="mb-3">Severity &amp; Priority</h5>

                    @{
                        var sevClass = Model.Severity switch
                        {
                            "Critical" => "bg-danger",
                            "High"     => "bg-warning",
                            "Moderate" => "bg-info",
                            _          => "bg-secondary"
                        };
                        var priClass = Model.Priority switch
                        {
                            "Critical" => "bg-danger",
                            "High"     => "bg-warning",
                            "Normal"   => "bg-info",
                            _          => "bg-secondary"
                        };
                    }

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted">Severity</span>
                            <span class="badge @sevClass">@Model.Severity</span>
                        </div>
                        <div class="progress" style="height:8px" title="Score: @Model.SeverityScore / 100">
                            <div class="progress-bar @sevClass"
                                 role="progressbar"
                                 style="width:@Model.SeverityScore%"
                                 aria-valuenow="@Model.SeverityScore"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                        <div class="text-end small text-muted mt-1">@Model.SeverityScore / 100</div>
                        @if (Model.SeverityReasons.Any())
                        {
                            <ul class="list-unstyled mt-2 mb-0">
                                @foreach (var r in Model.SeverityReasons)
                                {
                                    <li class="small text-muted">
                                        <span class="me-1 text-@(sevClass.Replace("bg-",""))">&#10003;</span>@r
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted">Priority</span>
                            <span class="badge @priClass">@Model.Priority</span>
                        </div>
                        <div class="progress" style="height:8px" title="Score: @Model.PriorityScore / 100">
                            <div class="progress-bar @priClass"
                                 role="progressbar"
                                 style="width:@Model.PriorityScore%"
                                 aria-valuenow="@Model.PriorityScore"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                        <div class="text-end small text-muted mt-1">@Model.PriorityScore / 100</div>
                        @if (Model.PriorityReasons.Any())
                        {
                            <ul class="list-unstyled mt-2 mb-0">
                                @foreach (var r in Model.PriorityReasons)
                                {
                                    <li class="small text-muted">
                                        <span class="me-1 text-@(priClass.Replace("bg-",""))">&#10003;</span>@r
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                </div>
            </div>

            @if (canReviewPrediction)
            {
                <div class="card shadow-sm mb-4" id="predictiveIntelligenceCard">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Predictive Intelligence</strong>
                        <span class="badge bg-warning text-dark">Advisory</span>
                    </div>
                    <div class="card-body">
                        @if (escalationPrediction is null)
                        {
                            <p class="small text-muted mb-3">
                                No escalation-risk prediction is available yet.
                            </p>
                        }
                        else
                        {
                            var probability = Math.Clamp(escalationPrediction.Probability * 100, 0, 100);
                            var riskClass = probability >= 70 ? "bg-danger" :
                                probability >= 50 ? "bg-warning" : "bg-success";
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted">Estimated escalation probability</span>
                                <strong>@probability.ToString("F1")%</strong>
                            </div>
                            <div class="progress mb-2" style="height: 10px">
                                <div class="progress-bar @riskClass"
                                     role="progressbar"
                                     style="width:@probability.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"
                                     aria-valuenow="@probability"
                                     aria-valuemin="0"
                                     aria-valuemax="100"></div>
                            </div>
                            <div class="small text-muted mb-2">
                                @escalationPrediction.ModelName v@escalationPrediction.ModelVersion
                                · @escalationPrediction.GeneratedAtUtc.ToString("dd MMM yyyy HH:mm:ss") UTC
                            </div>
                            <div class="small mb-3">
                                <strong>Signals considered</strong>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var signal in escalationPrediction.SignalsConsidered)
                                    {
                                        <span class="badge bg-light text-dark border">@signal.Key</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="alert alert-warning small mb-3">
                            &#9888; Advisory prediction &mdash; operator review required.
                            This signal never changes severity, priority, dispatch, or escalation state automatically.
                        </div>
                        <form asp-action="ReprocessPrediction" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                Re-evaluate Prediction
                            </button>
                        </form>
                    </div>
                </div>
            }

            @if (User.IsInRole("Operator") || User.IsInRole("EmergencyAdmin") || User.IsInRole("SystemAdmin"))
            {
                @* Only show status update for non-terminal incidents *@
                var isTerminal = Model.Status is "Closed" or "Rejected";

                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <strong>Update Status</strong>
                    </div>
                    <div class="card-body">

                        @if (isTerminal)
                        {
                            <div class="text-muted small">
                                This incident is <strong>@Model.Status</strong> and cannot be updated further.
                            </div>
                        }
                        else
                        {
                            <form asp-action="UpdateStatus"
                                  asp-route-id="@Model.Id"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label class="form-label" for="status">New Status</label>
                                    <select class="form-select" id="status" name="status">
                                        @foreach (var s in new[]
                                        {
                                            "Submitted", "UnderReview", "Assigned",
                                            "InProgress", "Escalated", "Resolved",
                                            "Closed", "Rejected"
                                        })
                                        {
                                            if (s != Model.Status)
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="remarks">Remarks</label>
                                    <textarea class="form-control"
                                              id="remarks"
                                              name="remarks"
                                              rows="2"
                                              placeholder="Optional notes..."></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary w-100">
                                    Update Status
                                </button>

                            </form>
                        }

                    </div>
                </div>

                @if (Model.AssignedResources != null && Model.AssignedResources.Any())
                {
                    <div class="card shadow-sm mb-4 border-start border-4 border-primary">
                        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                            <strong class="d-flex align-items-center gap-2">
                                <i class="bi bi-shield-check text-primary"></i>
                                <span>Assigned Units (@Model.AssignedResources.Count)</span>
                            </strong>
                            <a asp-controller="Resources" asp-action="Index" class="btn btn-outline-primary btn-sm py-0 px-2 small">Command Center</a>
                        </div>
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush small">
                                @foreach (var r in Model.AssignedResources)
                                {
                                    var resBadge = r.Status switch
                                    {
                                        "Available" => "bg-success",
                                        "Assigned" => "bg-primary",
                                        "Dispatched" => "bg-info text-dark",
                                        "EnRoute" => "bg-warning text-dark",
                                        "OnScene" => "bg-danger",
                                        "Returning" => "bg-secondary",
                                        _ => "bg-secondary"
                                    };
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <a asp-controller="Resources" asp-action="Details" asp-route-id="@r.ResourceId" class="fw-semibold text-decoration-none">
                                                @r.ResourceName
                                            </a>
                                            <span class="text-muted ms-1">(@r.ResourceType)</span>
                                            <div class="text-muted" style="font-size: 0.72rem;">
                                                Assigned: @r.AssignedAtUtc.ToString("HH:mm")
                                                @(r.OnSceneAtUtc.HasValue ? $" | On Scene: {r.OnSceneAtUtc.Value:HH:mm}" : "")
                                            </div>
                                        </div>
                                        <span class="badge @resBadge">@r.Status</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <div class="card shadow-sm mb-4 border-start border-4 border-info">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <strong class="d-flex align-items-center gap-2">
                            <i class="bi bi-truck text-info"></i>
                            <span>Unit Dispatch & Recommendations</span>
                        </strong>
                        <span class="badge bg-info-subtle text-info fw-semibold">Phase 11</span>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-3">
                            Evaluate eligible emergency response units ranked by proximity, availability, and incident requirement compatibility.
                        </p>
                        <a asp-controller="Resources"
                           asp-action="Recommendations"
                           asp-route-incidentId="@Model.Id"
                           class="btn btn-info text-white w-100 d-inline-flex justify-content-center align-items-center gap-2">
                            <i class="bi bi-compass"></i>
                            <span>View Recommended Units</span>
                        </a>
                    </div>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body">

                    <h5>Location</h5>

                    <p class="mb-1">
                        @Model.Address
                    </p>

                    <p class="mb-0">
                        @Model.City
                    </p>

                    <small class="text-muted">
                        @Model.Latitude,
                        @Model.Longitude
                    </small>

                </div>
            </div>

        </div>

    </div>

    @* Duplicate / canonical / related notices — inside the container *@

    @if (Model.HasDuplicateCandidates)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center mt-4">
            <div>
                <strong>Possible duplicate incidents detected.</strong>
                <div class="small">
                    Review the related reports before taking further action.
                </div>
            </div>

            <a asp-action="Duplicates"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Review Duplicates
            </a>
        </div>
    }

    @if (Model.CanonicalIncidentId.HasValue)
    {
        <div class="alert alert-info mt-4">
            This incident has been identified as a duplicate of
            <a asp-action="Details"
               asp-route-id="@Model.CanonicalIncidentId">
                @Model.CanonicalIncidentNumber
            </a>.
        </div>
    }

    @if (Model.RelatedIncidents.Count > 0)
    {
        <div class="card mt-4">
            <div class="card-header">
                <strong>Related Incident Reports</strong>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var relatedIncident in Model.RelatedIncidents)
                {
                    <a class="list-group-item list-group-item-action"
                       asp-action="Details"
                       asp-route-id="@relatedIncident.Id">
                        @relatedIncident.IncidentNumber
                        <span class="text-muted">
                            @relatedIncident.RelationType
                        </span>
                    </a>
                }
            </div>
        </div>
    }

    @if (User.IsInRole("Operator") || User.IsInRole("EmergencyAdmin") || User.IsInRole("SystemAdmin"))
{
    @* Status History timeline *@
    @if (Model.StatusHistory.Any())
    {
        <div class="card shadow-sm mt-4">
            <div class="card-header">
                <strong>Status History</strong>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var entry in Model.StatusHistory)
                    {
                        var newStatusClass = entry.NewStatus switch
                        {
                            "Resolved" or "Closed"  => "bg-success",
                            "Rejected"              => "bg-danger",
                            "Escalated"             => "bg-warning text-dark",
                            "InProgress"            => "bg-primary",
                            "Assigned"              => "bg-primary",
                            "UnderReview"           => "bg-info text-dark",
                            _                       => "bg-secondary"
                        };
                        <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-light text-dark border">@entry.OldStatus</span>
                                    <span class="text-muted small">&#8594;</span>
                                    <span class="badge @newStatusClass">@entry.NewStatus</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(entry.Remarks))
                                {
                                    <div class="small text-muted fst-italic">@entry.Remarks</div>
                                }
                            </div>
                            <div class="text-muted small text-nowrap ms-3">
                                @entry.ChangedAtUtc.ToString("dd MMM yyyy HH:mm")
                                @if (!string.IsNullOrWhiteSpace(entry.ChangedByUserId))
                                {
                                    <div class="text-muted" style="font-size:0.75rem">by @entry.ChangedByUserId[..Math.Min(8, entry.ChangedByUserId.Length)]&hellip;</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="card shadow-sm mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>Visual Evidence</strong>
                <div class="small text-muted">
                    AI-assisted analysis of uploaded incident media
                </div>
            </div>
        </div>

        <div class="card-body">
            @if (!visualEvidence.Any())
            {
                <div class="text-muted">
                    No visual evidence has been uploaded.
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in visualEvidence)
                    {
                        <div class="col-lg-6">
                            <div class="border rounded p-3" data-evidence-card="@item.MediaId">

                                @{
                                    var isVideo = item.ContentType.StartsWith("video/");
                                }

                                @if (isVideo)
                                {
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge bg-dark">VIDEO</span>
                                        <a href="@item.MediaUrl"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-secondary">
                                            &#9654; Original video
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-2">
                                        <span class="badge bg-secondary">IMAGE</span>
                                    </div>

                                    <button type="button"
                                            class="btn btn-link p-0 w-100"
                                            onclick="openEvidence('@item.MediaUrl')">
                                        <img src="@item.MediaUrl"
                                             alt="Incident evidence"
                                             class="img-fluid rounded" />
                                    </button>
                                }

                                @if (item.Analysis is not null)
                                {
                                    <hr />

                                    <div class="mb-2 d-flex flex-wrap gap-2 align-items-center">
                                        <span class="small text-muted">AI Analysis</span>
                                        <span class="badge @(item.Analysis.Status == VisualAnalysisStatus.RequiresReview ? "bg-warning text-dark" : item.Analysis.Status == VisualAnalysisStatus.Failed ? "bg-danger" : "bg-success")"
                                              data-analysis-status="@item.MediaId">
                                            @item.Analysis.Status
                                        </span>
                                    </div>

                                    @if (item.Analysis.HumanReviewed)
                                    {
                                        <div class="mb-2 d-flex flex-wrap gap-2 align-items-center">
                                            <span class="small text-muted">Human Review</span>
                                            <span class="badge @(item.Analysis.HumanReviewOutcome == "Rejected" ? "bg-danger" : "bg-primary")">
                                                @item.Analysis.HumanReviewOutcome
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(item.Analysis.HumanDecision))
                                            {
                                                <span class="small text-muted fst-italic">@item.Analysis.HumanDecision</span>
                                            }
                                        </div>
                                    }

                                    @if (isVideo && item.Analysis.FramesAnalyzed.HasValue)
                                    {
                                        <div class="small text-muted mb-2">
                                            @item.Analysis.FramesAnalyzed frames analyzed
                                            @if (item.Analysis.VideoDurationSeconds.HasValue)
                                            {
                                                var dur = TimeSpan.FromSeconds(item.Analysis.VideoDurationSeconds.Value);
                                                <span>&#8226; Duration: @dur.ToString(@"mm\:ss")</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="mb-1">@item.Analysis.SceneDescription</p>
                                    }

                                    <div class="small text-muted mb-2">
                                        Confidence: @item.Analysis.Confidence.ToString("P0")
                                    </div>

                                    @if (item.Analysis.DetectedHazards.Any())
                                    {
                                        <div class="mt-2 d-flex flex-wrap gap-1">
                                            @foreach (var hazard in item.Analysis.DetectedHazards)
                                            {
                                                <span class="badge bg-danger">@hazard</span>
                                            }
                                        </div>
                                    }

                                    <div class="row g-2 mt-2">
                                        <div class="col-6">
                                            <span class="small text-muted">Flooding</span>
                                            <div>@(item.Analysis.FloodingVisible ? "Yes" : "No")</div>
                                        </div>
                                        <div class="col-6">
                                            <span class="small text-muted">Road blocked</span>
                                            <div>@(item.Analysis.RoadAppearsBlocked ? "Yes" : "No")</div>
                                        </div>
                                        <div class="col-6">
                                            <span class="small text-muted">Fire</span>
                                            <div>@(item.Analysis.FireVisible ? "Yes" : "No")</div>
                                        </div>
                                        <div class="col-6">
                                            <span class="small text-muted">Smoke</span>
                                            <div>@(item.Analysis.SmokeVisible ? "Yes" : "No")</div>
                                        </div>
                                        <div class="col-6">
                                            <span class="small text-muted">Structural damage</span>
                                            <div>@(item.Analysis.StructuralDamageVisible ? "Yes" : "No")</div>
                                        </div>
                                        <div class="col-6">
                                            <span class="small text-muted">People trapped</span>
                                            <div>@(item.Analysis.PeopleAppearTrapped ? "Yes" : "No")</div>
                                        </div>
                                        <div class="col-6">
                                            <span class="small text-muted">Immediate danger</span>
                                            <div>@(item.Analysis.ImmediateDangerVisible ? "Yes" : "No")</div>
                                        </div>
                                        @if (item.Analysis.EstimatedVehiclesAffected.HasValue)
                                        {
                                            <div class="col-6">
                                                <span class="small text-muted">Vehicles affected</span>
                                                <div>@item.Analysis.EstimatedVehiclesAffected</div>
                                            </div>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Analysis.RecommendedResponse))
                                    {
                                        <div class="mt-3 p-2 bg-light rounded">
                                            <span class="small text-muted">Recommended Response</span>
                                            <div>@item.Analysis.RecommendedResponse</div>
                                        </div>
                                    }

                                    @if (isVideo && item.Analysis.FrameFindings.Any())
                                    {
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm mt-3 w-100"
                                                onclick="openFrameFindings('@item.IncidentId', '@item.MediaId', '@System.Text.Json.JsonSerializer.Serialize(item.Analysis.FrameFindings)')">
                                            View Frame Findings
                                        </button>
                                    }

                                    @if (item.Analysis.Status == VisualAnalysisStatus.RequiresReview)
                                    {
                                        <div class="alert alert-warning mt-3">
                                            <strong>Human review required.</strong>
                                            <div class="small mt-1">
                                                This visual analysis contains evidence requiring
                                                operator verification.
                                            </div>
                                            <a asp-action="VisualReview"
                                               asp-route-id="@Model.Id"
                                               asp-route-mediaId="@item.MediaId"
                                               class="btn btn-warning btn-sm mt-2">
                                                Review Analysis
                                            </a>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="mt-2">
                                        <span class="badge bg-secondary"
                                              data-analysis-status="@item.MediaId">
                                            Analyzing&hellip;
                                        </span>
                                    </div>
                                }

                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

}

@* Syncfusion dialogs live outside the role-check so the JS initialiser
   always finds and activates them during page load. *@
<ejs-dialog id="evidenceDialog"
            width="90%"
            height="90%"
            showCloseIcon="true"
            visible="false"
            isModal="true"
            header="Incident Evidence">
</ejs-dialog>

<ejs-dialog id="frameDialog"
            width="95%"
            height="95%"
            showCloseIcon="true"
            visible="false"
            isModal="true"
            header="Frame Findings">
</ejs-dialog>

<div class="modal fade" id="escalationActionModal" tabindex="-1" aria-labelledby="escalationModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="escalationModalTitle">Escalation Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="escalationActionId" />
                <input type="hidden" id="escalationActionType" />
                <div class="mb-3">
                    <label for="escalationNotes" class="form-label">Operator Notes / Rationale</label>
                    <textarea class="form-control" id="escalationNotes" rows="3" placeholder="Enter notes, operational context, or reason for this action..."></textarea>
                </div>
                <div id="escalationActionError" class="alert alert-danger d-none small"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="escalationSubmitBtn" onclick="submitEscalationAction()">Confirm</button>
            </div>
        </div>
    </div>
</div>

</div>@* end .container *@

@section Scripts {
    <script src="~/js/incident-details.js" asp-append-version="true"></script>
    <script>
        // Media upload via fetch so the page stays open after upload.
        (function () {
            var btn = document.getElementById('uploadBtn');
            var fileInput = document.getElementById('evidenceFile');
            var status = document.getElementById('uploadStatus');

            if (!btn) return;

            btn.addEventListener('click', async function () {
                var file = fileInput && fileInput.files && fileInput.files[0];
                if (!file) {
                    status.textContent = 'Please select a file first.';
                    status.className = 'mt-2 small text-danger';
                    return;
                }

                var isVideo = file.type.startsWith('video/');
                var maxBytes = isVideo ? 100 * 1024 * 1024 : 10 * 1024 * 1024;
                if (file.size > maxBytes) {
                    status.textContent = isVideo
                        ? 'Video must be under 100 MB.'
                        : 'Image must be under 10 MB.';
                    status.className = 'mt-2 small text-danger';
                    return;
                }

                btn.disabled = true;
                status.textContent = 'Uploading\u2026';
                status.className = 'mt-2 small text-muted';

                var form = new FormData();
                form.append('file', file);

                var incidentId = '@Model.Id';
                var endpoint = isVideo
                    ? '/api/incidents/' + incidentId + '/media/video'
                    : '/api/incidents/' + incidentId + '/media';

                var apiBase = (document.querySelector('script[data-api-base]') || {}).dataset
                    ? document.querySelector('script[data-api-base]').dataset.apiBase
                    : '';

                var token = (document.querySelector('meta[name="signalr-token"]') || {}).content || '';

                try {
                    var resp = await fetch(apiBase + endpoint, {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token },
                        body: form
                    });

                    if (resp.ok) {
                        status.textContent = 'Upload successful \u2014 AI analysis queued.';
                        status.className = 'mt-2 small text-success';
                        fileInput.value = '';
                        setTimeout(function () { location.reload(); }, 2000);
                    } else {
                        var msg = await resp.text().catch(function () { return resp.statusText; });
                        status.textContent = 'Upload failed: ' + msg;
                        status.className = 'mt-2 small text-danger';
                        btn.disabled = false;
                    }
                } catch (err) {
                    status.textContent = 'Upload error: ' + err.message;
                    status.className = 'mt-2 small text-danger';
                    btn.disabled = false;
                }
            });
        }());
    </script>
}
