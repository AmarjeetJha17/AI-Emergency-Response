@model EmergencyResponse.Web.Models.Map.EmergencyMapViewModel

@{
    ViewData["Title"] = "Live Emergency Map";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.css" />
    <link rel="stylesheet" href="~/lib/leaflet.markercluster/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="~/css/emergency-map.css" asp-append-version="true" />
}

<div class="container-fluid py-3" id="emergencyMapPage" data-selected-incident-id="@Model.SelectedIncidentId" data-selected-resource-id="@Model.SelectedResourceId">
    <!-- Header -->
    <header class="er-page-header mb-4">
        <div class="er-page-heading">
            <p class="er-eyebrow mb-1">Operations</p>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="er-page-title mb-0">Emergency Map</h1>
                <span id="mapConnectionStatus" class="badge bg-secondary" role="status" aria-live="polite">Snapshot view</span>
            </div>
            <p class="er-page-subtitle mb-0">Incident locations, response resources, and operational areas.</p>
        </div>
        <div class="er-page-actions">
            <span id="mapLastUpdated" class="text-muted small" aria-live="polite">Snapshot retrieved @Model.RetrievedAtUtc.ToString("dd-MMM-yyyy HH:mm:ss") UTC</span>
            <span id="mapRefreshStatus" class="small text-muted" role="status" aria-live="polite"></span>
            <button id="btnRefreshMap" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" title="Refresh Map Incidents" aria-label="Refresh map snapshot">
                <span id="mapRefreshSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                <span>↻ Refresh</span>
            </button>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary btn-sm">
                Dashboard
            </a>
            <a asp-controller="Incidents" asp-action="Index" class="btn btn-primary btn-sm">
                Incident List
            </a>
        </div>
    </header>

    <!-- Map Filters Card -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
            <div>
                <h2 class="h6 fw-semibold text-dark mb-0"><i class="bi bi-funnel me-1"></i>Map Filters & Layers</h2>
                <span class="small text-muted">Filter incidents and toggle operational layers.</span>
            </div>
            <span id="activeMapFilterSummary" class="small text-muted" aria-live="polite">Showing all active incidents.</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold small mb-1" for="mapSeverityFilter">Severity</label>
                    <select id="mapSeverityFilter" class="form-select form-select-sm">
                        <option value="">All severities</option>
                        <option value="Critical">Critical</option>
                        <option value="High">High</option>
                        <option value="Moderate">Moderate</option>
                        <option value="Low">Low</option>
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold small mb-1" for="mapPriorityFilter">Priority</label>
                    <select id="mapPriorityFilter" class="form-select form-select-sm">
                        <option value="">All priorities</option>
                        <option value="P1">Critical (P1)</option>
                        <option value="P2">High (P2)</option>
                        <option value="P3">Normal / Medium (P3)</option>
                        <option value="P4">Low (P4)</option>
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold small mb-1" for="mapStatusFilter">Status</label>
                    <select id="mapStatusFilter" class="form-select form-select-sm">
                        <option value="">All statuses</option>
                        @foreach (var status in Enum.GetValues<EmergencyResponse.Domain.Enums.IncidentStatus>().Where(s => s != EmergencyResponse.Domain.Enums.IncidentStatus.Closed))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold small mb-1" for="mapIncidentTypeFilter">Incident Type</label>
                    <select id="mapIncidentTypeFilter" class="form-select form-select-sm">
                        <option value="">All incident types</option>
                        @foreach (var type in Model.IncidentTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold small mb-1" for="mapDepartmentFilter">Department</label>
                    <select id="mapDepartmentFilter" class="form-select form-select-sm">
                        <option value="">All departments</option>
                        @foreach (var department in Model.Departments)
                        {
                            <option value="@department">@department</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="form-check mt-3">
                        <input id="mapAIReviewFilter" class="form-check-input" type="checkbox">
                        <label class="form-check-label small fw-semibold" for="mapAIReviewFilter">
                            AI review required
                        </label>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="form-check mt-3">
                        <input id="mapDuplicateFilter" class="form-check-input" type="checkbox">
                        <label class="form-check-label small fw-semibold" for="mapDuplicateFilter">
                            Duplicate review required
                        </label>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="form-check mt-3">
                        <input id="mapVisualFilter" class="form-check-input" type="checkbox">
                        <label class="form-check-label small fw-semibold" for="mapVisualFilter">
                            Visual review required
                        </label>
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-1 pt-2 border-top">
                <div class="col-md-6 col-lg-4">
                    <div class="form-check">
                        <input id="mapResourcesToggle" class="form-check-input" type="checkbox" checked>
                        <label class="form-check-label small fw-semibold" for="mapResourcesToggle">
                            Show operational resources
                        </label>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="form-check">
                        <input id="mapZonesToggle" class="form-check-input" type="checkbox" checked>
                        <label class="form-check-label small fw-semibold" for="mapZonesToggle">
                            Show operational alert radii
                        </label>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="form-check">
                        <input id="mapSituationsToggle" class="form-check-input" type="checkbox" checked>
                        <label class="form-check-label small fw-semibold" for="mapSituationsToggle">
                            Show operational situations (clusters)
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-3 pt-2 border-top">
                <button id="applyMapFilters" type="button" class="btn btn-primary btn-sm">
                    Apply Filters
                </button>
                <button id="clearMapFilters" type="button" class="btn btn-outline-secondary btn-sm">
                    Clear Filters
                </button>
                <button id="fitFilteredIncidents" type="button" class="btn btn-outline-primary btn-sm">
                    Fit to Results
                </button>
            </div>
        </div>
    </div>

    <!-- Stats Bar -->
    <div class="map-stats-bar">
        <div class="map-stat-badge">
            <span>Filtered Incidents:</span>
            <span id="mapIncidentCount" class="badge bg-primary">0 / 0 incidents</span>
        </div>
        <div class="map-stat-badge">
            <span>Resources:</span>
            <span id="statResources" class="badge bg-dark">@Model.Resources.Count</span>
        </div>
        <div class="map-stat-badge">
            <span class="map-legend-dot dot-critical"></span>
            <span>Critical:</span>
            <span id="statCritical" class="badge bg-danger">0</span>
        </div>
        <div class="map-stat-badge">
            <span class="map-legend-dot dot-high"></span>
            <span>High:</span>
            <span id="statHigh" class="badge bg-warning text-dark">0</span>
        </div>
        <div class="map-stat-badge">
            <span class="map-legend-dot dot-medium"></span>
            <span>Medium:</span>
            <span id="statMedium" class="badge bg-info text-dark">0</span>
        </div>
        <div class="map-stat-badge">
            <span class="map-legend-dot dot-low"></span>
            <span>Low:</span>
            <span id="statLow" class="badge bg-success">0</span>
        </div>
    </div>

    <!-- Map Container -->
    <div class="emergency-map-container">
        <div id="mapEmptyState" class="map-empty-state" role="status" aria-live="polite" hidden></div>
        <div id="emergencyMap"></div>
    </div>

    <!-- Incident Details Drawer (Offcanvas) -->
    <div class="offcanvas offcanvas-end shadow"
         tabindex="-1"
         id="incidentDetailsDrawer"
         aria-labelledby="incidentDetailsDrawerLabel">
        <div class="offcanvas-header border-bottom bg-light py-3">
            <h5 class="offcanvas-title fw-bold" id="incidentDetailsDrawerLabel">
                Incident Details
            </h5>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close">
            </button>
        </div>
        <div class="offcanvas-body" id="incidentDetailsContent">
            <div class="text-muted text-center py-5">
                Select an incident pin to view details.
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="emergencyMapConfig">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
{
    initialIncidents = Model.Incidents,
    initialResources = Model.Resources,
    initialOperationalZones = Model.OperationalZones,
    selectedIncidentId = Model.SelectedIncidentId,
    selectedResourceId = Model.SelectedResourceId,
    tileUrl = Model.TileUrl,
    attribution = Model.Attribution,
    defaultLatitude = Model.DefaultLatitude,
    defaultLongitude = Model.DefaultLongitude,
    defaultZoom = Model.DefaultZoom
}, new System.Text.Json.JsonSerializerOptions
{
    PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
}))
</script>

@section Scripts {
    <script src="~/lib/leaflet/dist/leaflet.js"></script>
    <script src="~/lib/leaflet.markercluster/dist/leaflet.markercluster.js"></script>
    <script src="~/js/emergency-map.js" asp-append-version="true"></script>
    <script src="~/js/emergency-situations-map.js" asp-append-version="true"></script>
}
