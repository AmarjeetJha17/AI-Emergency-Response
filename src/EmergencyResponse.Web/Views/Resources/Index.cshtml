@model EmergencyResponse.Web.Models.Resources.ResourceCommandCenterViewModel

@{
    ViewData["Title"] = "Resource Command Center";
}

<div class="container-fluid py-3" id="resourceCommandCenterPage">
    @Html.AntiForgeryToken()

    <!-- Header -->
    <header class="er-page-header mb-4">
        <div class="er-page-heading">
            <p class="er-eyebrow mb-1">Operations</p>
            <div class="d-flex align-items-center gap-2">
                <h1 class="er-page-title mb-0">Resource Command Center</h1>
                <span id="resourceConnectionStatus" class="badge bg-secondary d-inline-flex align-items-center gap-1 px-2 py-1" role="status" aria-live="polite">Connecting…</span>
            </div>
            <p class="er-page-subtitle mb-0">Fleet readiness, dispatch assignments, and operational state.</p>
        </div>
        <div class="er-page-actions">
            <span id="resourceLastUpdated" class="text-muted small" aria-live="polite">Snapshot retrieved @Model.RetrievedAtUtc.ToString("dd-MMM-yyyy HH:mm:ss") UTC</span>
            <span id="resourceRefreshStatus" class="small text-muted" role="status" aria-live="polite"></span>
            <button id="btnRefreshResources" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" title="Refresh Resources" aria-label="Refresh resource snapshot">
                <span id="resourceRefreshSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                <span>Refresh</span>
            </button>
            <a asp-controller="Map" asp-action="Index" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-geo-alt me-1"></i>Live Map
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm">
                Incident Dashboard
            </a>
        </div>
    </header>

    <!-- Operational KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase small text-muted fw-semibold">Available</div>
                            <div class="fs-2 fw-bold text-success" id="kpiAvailable">@Model.Summary.Available</div>
                            <div class="small text-muted">Ready for dispatch</div>
                        </div>
                        <div class="rounded-circle p-3 bg-success-subtle text-success">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase small text-muted fw-semibold">Assigned / Dispatched</div>
                            <div class="fs-2 fw-bold text-primary" id="kpiAssigned">@(Model.Summary.Assigned + Model.Summary.Dispatched)</div>
                            <div class="small text-muted">Assigned: @Model.Summary.Assigned | Dispatched: @Model.Summary.Dispatched</div>
                        </div>
                        <div class="rounded-circle p-3 bg-primary-subtle text-primary">
                            <i class="bi bi-person-badge fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase small text-muted fw-semibold">En Route</div>
                            <div class="fs-2 fw-bold text-warning-emphasis" id="kpiEnRoute">@Model.Summary.EnRoute</div>
                            <div class="small text-muted">Mobilized to incident</div>
                        </div>
                        <div class="rounded-circle p-3 bg-warning-subtle text-warning-emphasis">
                            <i class="bi bi-truck fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-danger h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase small text-muted fw-semibold">On Scene</div>
                            <div class="fs-2 fw-bold text-danger" id="kpiOnScene">@Model.Summary.OnScene</div>
                            <div class="small text-muted">Actively mitigating</div>
                        </div>
                        <div class="rounded-circle p-3 bg-danger-subtle text-danger">
                            <i class="bi bi-shield-shaded fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Status Pills -->
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3 px-1 small text-muted">
        <span class="fw-semibold">Fleet State:</span>
        <span class="badge bg-light text-dark border">
            Returning: <strong id="kpiReturning" class="ms-1">@Model.Summary.Returning</strong>
        </span>
        <span class="badge bg-light text-dark border">
            Maintenance: <strong id="kpiMaintenance" class="ms-1">@Model.Summary.Maintenance</strong>
        </span>
        <span class="badge bg-light text-dark border">
            Unavailable: <strong id="kpiUnavailable" class="ms-1">@Model.Summary.Unavailable</strong>
        </span>
        <span class="ms-auto small text-muted" id="fleetTotalUnits">
            Total Tracked Units: @Model.Resources.Count
        </span>
    </div>

    <!-- Resource Fleet Grid -->
    <section class="card shadow-sm" aria-labelledby="resourceRosterTitle">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="min-w-0">
                <h2 id="resourceRosterTitle" class="h6 fw-bold text-dark mb-1"><i class="bi bi-grid-3x3-gap-fill me-2 text-primary"></i>Operational Fleet Roster</h2>
                <p class="text-muted small mb-0">Search, filter, and manage the model-backed fleet roster.</p>
            </div>
        </div>

        <div class="card-body p-0 resource-grid-scroll" role="region" aria-label="Resource fleet roster, horizontally scrollable" tabindex="0">
            <ejs-grid id="resourceGrid"
                      dataSource="@Model.Resources"
                      toolbar="@(new List<string>() { "Search", "ColumnChooser" })"
                      allowPaging="true"
                      allowSorting="true"
                      allowFiltering="true"
                      allowResizing="true"
                      allowReordering="true"
                      showColumnChooser="true"
                      height="520">

                <e-grid-pageSettings pageSize="15" pageSizes="true">
                </e-grid-pageSettings>

                <e-grid-filterSettings type="Menu">
                </e-grid-filterSettings>

                <e-grid-columns>
                    <e-grid-column field="Name"
                                   headerText="Unit Name"
                                   width="160"
                                   freeze="Left">
                    </e-grid-column>

                    <e-grid-column field="ResourceType"
                                   headerText="Type"
                                   width="130"
                                   filter="@(new { type = "CheckBox" })">
                    </e-grid-column>

                    <e-grid-column field="DepartmentName"
                                   headerText="Department"
                                   width="160">
                    </e-grid-column>

                    <e-grid-column field="Status"
                                   headerText="Status"
                                   width="140"
                                   template="#resourceStatusTemplate"
                                   filter="@(new { type = "CheckBox" })">
                    </e-grid-column>

                    <e-grid-column field="ActiveIncidentNumber"
                                   headerText="Active Incident"
                                   width="180"
                                   template="#resourceIncidentTemplate">
                    </e-grid-column>

                    <e-grid-column field="AssignedAtUtc"
                                   headerText="Assigned At"
                                   type="dateTime"
                                   format="dd-MMM HH:mm"
                                   width="140">
                    </e-grid-column>

                    <e-grid-column headerText="Actions"
                                   width="230"
                                   template="#resourceActionsTemplate"
                                   allowSorting="false"
                                   allowFiltering="false">
                    </e-grid-column>
                </e-grid-columns>
            </ejs-grid>
        </div>
    </section>
</div>

<!-- Assign Resource Modal Dialog -->
<ejs-dialog id="assignResourceDialog"
            width="500px"
            showCloseIcon="true"
            visible="false"
            isModal="true"
            header="Assign Resource to Incident">
    <e-content-template>
        <div id="assignDialogBody" class="p-2">
            <div id="assignAlertContainer"></div>

            <div class="mb-3">
                <label class="form-label text-muted small mb-1">Resource Unit</label>
                <div class="fw-bold fs-6" id="assignTargetName">-</div>
                <div class="small text-muted" id="assignTargetDepartment">-</div>
            </div>

            <input type="hidden" id="assignResourceId" value="" />

            <div class="mb-3">
                <label for="assignIncidentSelect" class="form-label fw-semibold small">
                    Target Incident <span class="text-danger">*</span>
                </label>
                <select id="assignIncidentSelect" class="form-select form-select-sm" required>
                    <option value="">Loading eligible incidents...</option>
                </select>
                <div class="form-text small">Showing active incidents matching the resource department.</div>
            </div>

            <div class="mb-3">
                <label for="assignNotes" class="form-label fw-semibold small">Operational Notes / Dispatch Orders</label>
                <textarea id="assignNotes" class="form-control form-control-sm" rows="3" placeholder="Optional dispatch instructions..."></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="closeAssignDialog()">Cancel</button>
                <button type="button" id="btnSubmitAssign" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" onclick="submitAssignment()">
                    <span id="assignSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                    <span>Confirm Assignment</span>
                </button>
            </div>
        </div>
    </e-content-template>
</ejs-dialog>

<!-- Update Status Modal Dialog -->
<ejs-dialog id="resourceStatusDialog"
            width="500px"
            showCloseIcon="true"
            visible="false"
            isModal="true"
            header="Update Resource Operational Status">
    <e-content-template>
        <div id="statusDialogBody" class="p-2">
            <div id="statusAlertContainer"></div>

            <div class="mb-3">
                <label class="form-label text-muted small mb-1">Resource Unit</label>
                <div class="fw-bold fs-6" id="statusTargetName">-</div>
                <div class="small">
                    Current Status: <span class="badge bg-secondary" id="statusCurrentBadge">-</span>
                </div>
            </div>

            <input type="hidden" id="statusResourceId" value="" />
            <input type="hidden" id="statusIncidentId" value="" />

            <div class="mb-3">
                <label for="nextStatusSelect" class="form-label fw-semibold small">
                    Next Operational Status <span class="text-danger">*</span>
                </label>
                <select id="nextStatusSelect" class="form-select form-select-sm" required>
                    <option value="">Select status transition...</option>
                </select>
                <div class="form-text small" id="nextStatusHelpText">Controlled operational progression.</div>
            </div>

            <div class="mb-3">
                <label for="statusReason" class="form-label fw-semibold small">Reason / Remarks</label>
                <textarea id="statusReason" class="form-control form-control-sm" rows="3" placeholder="Operational rationale or situational remarks..."></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="closeStatusDialog()">Cancel</button>
                <button type="button" id="btnSubmitStatus" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" onclick="submitStatusChange()">
                    <span id="statusSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                    <span>Update Status</span>
                </button>
            </div>
        </div>
    </e-content-template>
</ejs-dialog>

<!-- Dispatch Command Confirmation Dialog -->
<ejs-dialog id="resourceCommandDialog"
            width="460px"
            showCloseIcon="true"
            visible="false"
            isModal="true"
            header="Confirm Operational Dispatch Command">
    <e-content-template>
        <div id="commandDialogBody" class="p-2">
            <div id="commandAlertContainer"></div>

            <div class="mb-3">
                <label class="form-label text-muted small mb-1">Resource Unit</label>
                <div class="fw-bold fs-6" id="commandTargetName">-</div>
                <div class="small text-muted" id="commandIncidentContainer">
                    Active Incident: <span class="fw-semibold text-primary" id="commandTargetIncident">-</span>
                </div>
            </div>

            <div class="mb-3 p-2 bg-light rounded border">
                <div class="small text-muted mb-1">Target Operational State:</div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary fs-6" id="commandTargetBadge">-</span>
                </div>
            </div>

            <input type="hidden" id="commandResourceId" value="" />
            <input type="hidden" id="commandActionType" value="" />

            <div class="mb-3">
                <label for="commandNotes" class="form-label fw-semibold small">Operational Notes / Reason (Optional)</label>
                <textarea id="commandNotes" class="form-control form-control-sm" rows="3" placeholder="Optional remarks e.g., 'Arrived west entrance', 'Patient handover completed'"></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="closeCommandDialog()">Cancel</button>
                <button type="button" id="btnSubmitCommand" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" onclick="submitResourceCommand()">
                    <span id="commandSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                    <span id="commandSubmitLabel">Confirm Command</span>
                </button>
            </div>
        </div>
    </e-content-template>
</ejs-dialog>

<!-- Grid Column Templates -->
<script>
    function escapeResourceHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, function (character) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character];
        });
    }
</script>
<script id="resourceStatusTemplate" type="text/x-template">
    ${if(Status == "Available" || Status == 0)}
        <span class="badge bg-success">Available</span>
    ${else if(Status == "Assigned" || Status == 1)}
        <span class="badge bg-primary">Assigned</span>
    ${else if(Status == "Dispatched" || Status == 2)}
        <span class="badge bg-info text-dark">Dispatched</span>
    ${else if(Status == "EnRoute" || Status == 3)}
        <span class="badge bg-warning text-dark">En Route</span>
    ${else if(Status == "OnScene" || Status == 4)}
        <span class="badge bg-danger">On Scene</span>
    ${else if(Status == "Returning" || Status == 5)}
        <span class="badge bg-secondary">Returning</span>
    ${else if(Status == "Unavailable" || Status == 6)}
        <span class="badge bg-dark">Unavailable</span>
    ${else if(Status == "Maintenance" || Status == 7)}
        <span class="badge bg-secondary text-light">Maintenance</span>
    ${else}
        <span class="badge bg-light text-dark border">Other status</span>
    ${/if}
</script>

<script id="resourceIncidentTemplate" type="text/x-template">
    ${if(ActiveIncidentNumber)}
        <div>
            <a href="/Dashboard?incidentId=${ActiveIncidentId}" class="badge bg-primary-subtle text-primary border border-primary text-decoration-none" title="${escapeResourceHtml(ActiveIncidentTitle || 'Open assigned incident')}">
                ${escapeResourceHtml(ActiveIncidentNumber)}
            </a>
            ${if(ActiveIncidentTitle)}
                <div class="small text-muted text-truncate" style="max-width: 170px;" title="${escapeResourceHtml(ActiveIncidentTitle)}">
                    ${escapeResourceHtml(ActiveIncidentTitle)}
                </div>
            ${/if}
        </div>
    ${else}
        <span class="text-muted small">None</span>
    ${/if}
</script>

<script id="resourceActionsTemplate" type="text/x-template">
    <div class="btn-group btn-group-sm">
        <a href="/Resources/Details/${Id}" class="btn btn-outline-secondary py-0 px-2" title="View Full Details">View</a>
        
        ${if(Latitude && Longitude)}
            <a href="/Map?resourceId=${Id}" class="btn btn-outline-secondary py-0 px-2" title="Locate on Map">Map</a>
        ${/if}

        ${if(Status == "Available" || Status == 0)}
            <button type="button" class="btn btn-outline-success py-0 px-2" data-resource-action="assign" data-resource-id="${Id}" data-resource-name="${escapeResourceHtml(Name)}" data-resource-department="${escapeResourceHtml(DepartmentName || '')}">
                Assign
            </button>
        ${else if(Status == "Assigned" || Status == 1)}
            <button type="button" class="btn btn-outline-primary py-0 px-2 fw-semibold" data-resource-action="command" data-resource-id="${Id}" data-resource-name="${escapeResourceHtml(Name)}" data-resource-command="Dispatch" data-resource-target="Dispatched" data-resource-incident="${escapeResourceHtml(ActiveIncidentNumber || '')}">
                Dispatch
            </button>
        ${else if(Status == "Dispatched" || Status == 2)}
            <button type="button" class="btn btn-outline-info text-dark py-0 px-2 fw-semibold" data-resource-action="command" data-resource-id="${Id}" data-resource-name="${escapeResourceHtml(Name)}" data-resource-command="MarkEnRoute" data-resource-target="En Route" data-resource-incident="${escapeResourceHtml(ActiveIncidentNumber || '')}">
                En Route
            </button>
        ${else if(Status == "EnRoute" || Status == 3)}
            <button type="button" class="btn btn-outline-danger py-0 px-2 fw-semibold" data-resource-action="command" data-resource-id="${Id}" data-resource-name="${escapeResourceHtml(Name)}" data-resource-command="MarkOnScene" data-resource-target="On Scene" data-resource-incident="${escapeResourceHtml(ActiveIncidentNumber || '')}">
                On Scene
            </button>
        ${else if(Status == "OnScene" || Status == 4)}
            <button type="button" class="btn btn-outline-secondary py-0 px-2 fw-semibold" data-resource-action="command" data-resource-id="${Id}" data-resource-name="${escapeResourceHtml(Name)}" data-resource-command="BeginReturn" data-resource-target="Returning" data-resource-incident="${escapeResourceHtml(ActiveIncidentNumber || '')}">
                Begin Return
            </button>
        ${else if(Status == "Returning" || Status == 5)}
            <button type="button" class="btn btn-outline-success py-0 px-2 fw-semibold" data-resource-action="command" data-resource-id="${Id}" data-resource-name="${escapeResourceHtml(Name)}" data-resource-command="MarkAvailable" data-resource-target="Available" data-resource-incident="${escapeResourceHtml(ActiveIncidentNumber || '')}">
                Available
            </button>
        ${else}
            <button type="button" class="btn btn-outline-secondary py-0 px-2" data-resource-action="status" data-resource-id="${Id}" data-resource-name="${escapeResourceHtml(Name)}" data-resource-status="${escapeResourceHtml(Status)}" data-resource-incident="${ActiveIncidentId || ''}">
                Update
            </button>
        ${/if}
    </div>
</script>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var isRefreshing = false;

            function getCsrfToken() {
                var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : '';
            }

            function showResourceAlert(container, message) {
                if (!container) return;
                var alert = document.createElement('div');
                alert.className = 'alert alert-danger py-2 small';
                alert.textContent = message;
                container.replaceChildren(alert);
            }

            function setConnectionStatus(text, badgeClass) {
                var el = document.getElementById('resourceConnectionStatus');
                if (el) {
                    el.className = 'badge d-inline-flex align-items-center gap-1 px-2 py-1 ' + badgeClass;
                    el.textContent = text;
                }
            }

            function setRefreshStatus(state, message) {
                var el = document.getElementById('resourceRefreshStatus');
                if (!el) return;
                el.dataset.state = state;
                el.textContent = message;
                el.className = 'small ' + (state === 'failed' ? 'text-danger' : state === 'current' ? 'text-success' : 'text-muted');
            }

            function updateKPIs(summary) {
                if (!summary) return;
                var elAvail = document.getElementById('kpiAvailable');
                if (elAvail) elAvail.textContent = summary.available;

                var elAssigned = document.getElementById('kpiAssigned');
                if (elAssigned) elAssigned.textContent = (summary.assigned || 0) + (summary.dispatched || 0);

                var elEnRoute = document.getElementById('kpiEnRoute');
                if (elEnRoute) elEnRoute.textContent = summary.enRoute;

                var elOnScene = document.getElementById('kpiOnScene');
                if (elOnScene) elOnScene.textContent = summary.onScene;

                var elRet = document.getElementById('kpiReturning');
                if (elRet) elRet.textContent = summary.returning;

                var elMaint = document.getElementById('kpiMaintenance');
                if (elMaint) elMaint.textContent = summary.maintenance;

                var elUnavail = document.getElementById('kpiUnavailable');
                if (elUnavail) elUnavail.textContent = summary.unavailable;
            }

            function isValidSummary(summary) {
                return summary && ['available', 'assigned', 'dispatched', 'enRoute', 'onScene', 'returning', 'unavailable', 'maintenance']
                    .every(function (key) { return Number.isInteger(summary[key]) && summary[key] >= 0; });
            }

            async function refreshCommandCenter() {
                if (isRefreshing) return;
                isRefreshing = true;

                var spinner = document.getElementById('resourceRefreshSpinner');
                var refreshButton = document.getElementById('btnRefreshResources');
                if (spinner) spinner.classList.remove('d-none');
                if (refreshButton) refreshButton.disabled = true;
                setRefreshStatus('loading', 'Refreshing fleet snapshot…');

                try {
                    var response = await fetch('/Resources/Snapshot', {
                        headers: { 'Accept': 'application/json' }
                    });

                    if (!response.ok) throw new Error('Snapshot request failed (' + response.status + ').');
                    var data = await response.json();
                    if (!data || !isValidSummary(data.summary) || !Array.isArray(data.resources) || !data.updatedAtUtc || Number.isNaN(Date.parse(data.updatedAtUtc))) {
                        throw new Error('Snapshot response was incomplete.');
                    }
                    updateKPIs(data.summary);

                    var gridEl = document.getElementById('resourceGrid');
                    var grid = gridEl?.ej2_instances?.[0];
                    if (grid) {
                        grid.dataSource = data.resources;
                        grid.refresh();
                    }

                    var totalEl = document.getElementById('fleetTotalUnits');
                    if (totalEl) totalEl.textContent = 'Total Tracked Units: ' + data.resources.length;

                    var lastUpdatedEl = document.getElementById('resourceLastUpdated');
                    if (lastUpdatedEl) lastUpdatedEl.textContent = 'Snapshot retrieved ' + new Date(data.updatedAtUtc).toLocaleString('en-GB', { timeZone: 'UTC' }) + ' UTC';
                    setRefreshStatus('current', 'Snapshot current');
                } catch (e) {
                    setRefreshStatus('failed', 'Refresh failed. Showing the last retrieved snapshot.');
                    console.error('[ResourceCommandCenter] Refresh failed:', e);
                } finally {
                    isRefreshing = false;
                    if (spinner) spinner.classList.add('d-none');
                    if (refreshButton) refreshButton.disabled = false;
                }
            }

            // Expose for SignalR real-time client
            window.resourceCommandCenter = {
                refresh: refreshCommandCenter,
                setConnectionStatus: setConnectionStatus
            };

            document.addEventListener('DOMContentLoaded', function () {
                var btn = document.getElementById('btnRefreshResources');
                if (btn) btn.addEventListener('click', refreshCommandCenter);

                var grid = document.getElementById('resourceGrid');
                if (grid) grid.addEventListener('click', function (event) {
                    var button = event.target.closest('[data-resource-action]');
                    if (!button) return;
                    var action = button.dataset.resourceAction;
                    if (action === 'assign') {
                        window.openAssignModal(button.dataset.resourceId, button.dataset.resourceName, button.dataset.resourceDepartment);
                    } else if (action === 'command') {
                        window.openCommandModal(button.dataset.resourceId, button.dataset.resourceName,
                            button.dataset.resourceCommand, button.dataset.resourceTarget, button.dataset.resourceIncident);
                    } else if (action === 'status') {
                        window.openStatusModal(button.dataset.resourceId, button.dataset.resourceName,
                            button.dataset.resourceStatus, button.dataset.resourceIncident);
                    }
                });
            });

            // ── Assign Modal Logic ──────────────────────────────────────────────
            window.openAssignModal = async function (resourceId, resourceName, departmentName) {
                var alertContainer = document.getElementById('assignAlertContainer');
                if (alertContainer) alertContainer.innerHTML = '';

                document.getElementById('assignResourceId').value = resourceId;
                document.getElementById('assignTargetName').textContent = resourceName;
                document.getElementById('assignTargetDepartment').textContent = departmentName || 'Unknown department';
                document.getElementById('assignNotes').value = '';

                var select = document.getElementById('assignIncidentSelect');
                select.innerHTML = '<option value="">Loading eligible incidents...</option>';

                var dialogEl = document.getElementById('assignResourceDialog');
                var dialog = dialogEl?.ej2_instances?.[0];
                if (dialog) dialog.show();

                try {
                    var response = await fetch('/Resources/AssignableIncidents?resourceId=' + encodeURIComponent(resourceId), {
                        headers: { 'Accept': 'application/json' }
                    });

                    if (response.ok) {
                        var incidents = await response.json();
                        select.innerHTML = '';
                        if (!incidents || incidents.length === 0) {
                            select.innerHTML = '<option value="">No eligible open incidents available</option>';
                        } else {
                            select.innerHTML = '<option value="">-- Select Target Incident --</option>';
                            incidents.forEach(function (inc) {
                                var opt = document.createElement('option');
                                opt.value = inc.id;
                                opt.textContent = inc.incidentNumber + ' — ' + inc.title + ' (' + inc.priority + ')';
                                select.appendChild(opt);
                            });
                        }
                    } else {
                        select.innerHTML = '<option value="">Failed to load incidents</option>';
                    }
                } catch (err) {
                    select.innerHTML = '<option value="">Error loading incidents</option>';
                }
            };

            window.closeAssignDialog = function () {
                var dialogEl = document.getElementById('assignResourceDialog');
                var dialog = dialogEl?.ej2_instances?.[0];
                if (dialog) dialog.hide();
            };

            window.submitAssignment = async function () {
                var resourceId = document.getElementById('assignResourceId').value;
                var incidentId = document.getElementById('assignIncidentSelect').value;
                var notes = document.getElementById('assignNotes').value;
                var alertContainer = document.getElementById('assignAlertContainer');

                if (!incidentId) {
                    showResourceAlert(alertContainer, 'Please select an incident to assign.');
                    return;
                }

                var spinner = document.getElementById('assignSpinner');
                var btn = document.getElementById('btnSubmitAssign');
                spinner.classList.remove('d-none');
                btn.disabled = true;

                try {
                    var response = await fetch('/Resources/Assign', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getCsrfToken()
                        },
                        body: JSON.stringify({
                            resourceId: resourceId,
                            incidentId: incidentId,
                            notes: notes
                        })
                    });

                    var result = await response.json();
                    if (response.ok && result.success) {
                        closeAssignDialog();
                        await refreshCommandCenter();
                    } else {
                        showResourceAlert(alertContainer, result.message || 'Assignment failed.');
                    }
                } catch (err) {
                    showResourceAlert(alertContainer, 'Network or server error during assignment.');
                } finally {
                    spinner.classList.add('d-none');
                    btn.disabled = false;
                }
            };

            // ── Status Modal Logic ──────────────────────────────────────────────
            var VALID_STATUS_MAP = {
                'Available': [
                    { value: 'Maintenance', text: 'Place in Maintenance' },
                    { value: 'Unavailable', text: 'Mark Unavailable' }
                ],
                '0': [
                    { value: 'Maintenance', text: 'Place in Maintenance' },
                    { value: 'Unavailable', text: 'Mark Unavailable' }
                ],
                'Assigned': [
                    { value: 'Dispatched', text: 'Dispatch Unit' },
                    { value: 'EnRoute', text: 'Mark En Route' },
                    { value: 'Available', text: 'Release / Stand Down to Available' }
                ],
                '1': [
                    { value: 'Dispatched', text: 'Dispatch Unit' },
                    { value: 'EnRoute', text: 'Mark En Route' },
                    { value: 'Available', text: 'Release / Stand Down to Available' }
                ],
                'Dispatched': [
                    { value: 'EnRoute', text: 'Mark En Route' },
                    { value: 'OnScene', text: 'Mark On Scene' },
                    { value: 'Available', text: 'Abort Dispatch / Return to Available' }
                ],
                '2': [
                    { value: 'EnRoute', text: 'Mark En Route' },
                    { value: 'OnScene', text: 'Mark On Scene' },
                    { value: 'Available', text: 'Abort Dispatch / Return to Available' }
                ],
                'EnRoute': [
                    { value: 'OnScene', text: 'Arrived On Scene' },
                    { value: 'Returning', text: 'Reroute / Return to Base' },
                    { value: 'Available', text: 'Abort / Return to Available' }
                ],
                '3': [
                    { value: 'OnScene', text: 'Arrived On Scene' },
                    { value: 'Returning', text: 'Reroute / Return to Base' },
                    { value: 'Available', text: 'Abort / Return to Available' }
                ],
                'OnScene': [
                    { value: 'Returning', text: 'Operations Completed / Returning' },
                    { value: 'Available', text: 'Immediate Release to Available' }
                ],
                '4': [
                    { value: 'Returning', text: 'Operations Completed / Returning' },
                    { value: 'Available', text: 'Immediate Release to Available' }
                ],
                'Returning': [
                    { value: 'Available', text: 'Back in Quarters / Available' },
                    { value: 'Maintenance', text: 'Refuel / Maintenance' }
                ],
                '5': [
                    { value: 'Available', text: 'Back in Quarters / Available' },
                    { value: 'Maintenance', text: 'Refuel / Maintenance' }
                ],
                'Unavailable': [
                    { value: 'Available', text: 'Restore to Available' },
                    { value: 'Maintenance', text: 'Move to Maintenance' }
                ],
                '6': [
                    { value: 'Available', text: 'Restore to Available' },
                    { value: 'Maintenance', text: 'Move to Maintenance' }
                ],
                'Maintenance': [
                    { value: 'Available', text: 'Maintenance Complete / Available' },
                    { value: 'Unavailable', text: 'Mark Unavailable' }
                ],
                '7': [
                    { value: 'Available', text: 'Maintenance Complete / Available' },
                    { value: 'Unavailable', text: 'Mark Unavailable' }
                ]
            };

            window.openStatusModal = function (resourceId, resourceName, currentStatus, incidentId) {
                var alertContainer = document.getElementById('statusAlertContainer');
                if (alertContainer) alertContainer.innerHTML = '';

                document.getElementById('statusResourceId').value = resourceId;
                document.getElementById('statusIncidentId').value = incidentId && incidentId !== 'null' ? incidentId : '';
                document.getElementById('statusTargetName').textContent = resourceName;
                document.getElementById('statusCurrentBadge').textContent = currentStatus;
                document.getElementById('statusReason').value = '';

                var select = document.getElementById('nextStatusSelect');
                select.innerHTML = '';

                var options = VALID_STATUS_MAP[currentStatus] || [
                    { value: 'Available', text: 'Available' },
                    { value: 'Returning', text: 'Returning' },
                    { value: 'Maintenance', text: 'Maintenance' },
                    { value: 'Unavailable', text: 'Unavailable' }
                ];

                select.innerHTML = '<option value="">-- Select Next Status --</option>';
                options.forEach(function (opt) {
                    var optionEl = document.createElement('option');
                    optionEl.value = opt.value;
                    optionEl.textContent = opt.text;
                    select.appendChild(optionEl);
                });

                var dialogEl = document.getElementById('resourceStatusDialog');
                var dialog = dialogEl?.ej2_instances?.[0];
                if (dialog) dialog.show();
            };

            window.closeStatusDialog = function () {
                var dialogEl = document.getElementById('resourceStatusDialog');
                var dialog = dialogEl?.ej2_instances?.[0];
                if (dialog) dialog.hide();
            };

            window.submitStatusChange = async function () {
                var resourceId = document.getElementById('statusResourceId').value;
                var nextStatus = document.getElementById('nextStatusSelect').value;
                var incidentIdVal = document.getElementById('statusIncidentId').value;
                var reason = document.getElementById('statusReason').value;
                var alertContainer = document.getElementById('statusAlertContainer');

                if (!nextStatus) {
                    showResourceAlert(alertContainer, 'Please select a status transition.');
                    return;
                }

                var spinner = document.getElementById('statusSpinner');
                var btn = document.getElementById('btnSubmitStatus');
                spinner.classList.remove('d-none');
                btn.disabled = true;

                try {
                    var response = await fetch('/Resources/ChangeStatus', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getCsrfToken()
                        },
                        body: JSON.stringify({
                            resourceId: resourceId,
                            status: nextStatus,
                            incidentId: incidentIdVal ? incidentIdVal : null,
                            reason: reason
                        })
                    });

                    var result = await response.json();
                    if (response.ok && result.success) {
                        closeStatusDialog();
                        await refreshCommandCenter();
                    } else {
                        showResourceAlert(alertContainer, result.message || 'Status transition failed.');
                    }
                } catch (err) {
                    showResourceAlert(alertContainer, 'Network or server error during status transition.');
                } finally {
                    spinner.classList.add('d-none');
                    btn.disabled = false;
                }
            };

            // ── Dispatch Command Modal Logic ────────────────────────────────────
            window.openCommandModal = function (resourceId, resourceName, command, targetStatusText, incidentNumber) {
                var alertContainer = document.getElementById('commandAlertContainer');
                if (alertContainer) alertContainer.innerHTML = '';

                document.getElementById('commandResourceId').value = resourceId;
                document.getElementById('commandActionType').value = command;
                document.getElementById('commandTargetName').textContent = resourceName;
                document.getElementById('commandTargetIncident').textContent = incidentNumber && incidentNumber !== 'null' ? incidentNumber : 'Unassigned';
                document.getElementById('commandNotes').value = '';

                var targetBadge = document.getElementById('commandTargetBadge');
                if (targetBadge) {
                    targetBadge.textContent = targetStatusText;
                    var badgeClass = 'bg-primary';
                    if (targetStatusText === 'Dispatched') badgeClass = 'bg-info text-dark';
                    else if (targetStatusText === 'En Route') badgeClass = 'bg-warning text-dark';
                    else if (targetStatusText === 'On Scene') badgeClass = 'bg-danger';
                    else if (targetStatusText === 'Returning') badgeClass = 'bg-secondary';
                    else if (targetStatusText === 'Available') badgeClass = 'bg-success';
                    targetBadge.className = 'badge fs-6 ' + badgeClass;
                }

                var submitLabel = document.getElementById('commandSubmitLabel');
                if (submitLabel) {
                    submitLabel.textContent = 'Confirm ' + (command === 'Dispatch' ? 'Dispatch' :
                                                           command === 'MarkEnRoute' ? 'En Route' :
                                                           command === 'MarkOnScene' ? 'On Scene' :
                                                           command === 'BeginReturn' ? 'Return' :
                                                           command === 'MarkAvailable' ? 'Available' : 'Command');
                }

                var dialogEl = document.getElementById('resourceCommandDialog');
                var dialog = dialogEl?.ej2_instances?.[0];
                if (dialog) dialog.show();
            };

            window.closeCommandDialog = function () {
                var dialogEl = document.getElementById('resourceCommandDialog');
                var dialog = dialogEl?.ej2_instances?.[0];
                if (dialog) dialog.hide();
            };

            window.submitResourceCommand = async function () {
                var resourceId = document.getElementById('commandResourceId').value;
                var command = document.getElementById('commandActionType').value;
                var notes = document.getElementById('commandNotes').value;
                var alertContainer = document.getElementById('commandAlertContainer');

                var spinner = document.getElementById('commandSpinner');
                var btn = document.getElementById('btnSubmitCommand');
                spinner.classList.remove('d-none');
                btn.disabled = true;

                try {
                    var response = await fetch('/Resources/Command', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getCsrfToken()
                        },
                        body: JSON.stringify({
                            resourceId: resourceId,
                            command: command,
                            notes: notes ? notes : null
                        })
                    });

                    if (response.status === 409) {
                        closeCommandDialog();
                        await refreshCommandCenter();
                        alert("The resource was changed by another operator. The latest fleet state has been reloaded.");
                        return;
                    }

                    var result = await response.json();
                    if (response.ok && result.success) {
                        closeCommandDialog();
                        await refreshCommandCenter();
                    } else {
                        showResourceAlert(alertContainer, result.message || 'Resource command failed.');
                    }
                } catch (err) {
                    showResourceAlert(alertContainer, 'Network or server error during command execution.');
                } finally {
                    spinner.classList.add('d-none');
                    btn.disabled = false;
                }
            };
        })();
    </script>
}
