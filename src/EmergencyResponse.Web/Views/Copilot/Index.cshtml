@model EmergencyResponse.Web.Controllers.CopilotPageModel
@using EmergencyResponse.Application.Copilot
@using EmergencyResponse.Domain.Knowledge

@{
    ViewData["Title"] = "Emergency Response Copilot";
    var response = Model.Response;
    var grounded = response?.GroundingStatus == GroundingStatus.Grounded;
}

<main class="container py-4 er-copilot">
    <header class="er-page-header">
        <div class="er-page-heading">
            <div class="er-eyebrow">Operational guidance</div>
            <h1 class="er-page-title">Emergency Response Copilot</h1>
            <p class="er-page-subtitle">Ask about authorized procedures. Treat responses as advisory and verify them against the cited source material.</p>
        </div>
    </header>

    @if (TempData["CopilotActionMessage"] is string actionMessage)
    {
        <div class="alert alert-info" role="status">@actionMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ActionMessage))
    {
        <div class="alert alert-warning" role="status">@Model.ActionMessage</div>
    }

    <section class="er-panel p-4 mb-4" aria-labelledby="copilotQuestionHeading">
        <h2 class="er-section-title mb-3" id="copilotQuestionHeading">Ask a question</h2>
        <form method="post" asp-action="Index">
            @Html.AntiForgeryToken()
            <input asp-for="IncidentId" type="hidden" />
            <input asp-for="SituationId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <label asp-for="Question" class="form-label fw-semibold">Question</label>
            <textarea asp-for="Question" class="form-control" rows="4" aria-describedby="copilotQuestionHint"
                      placeholder="What procedure applies to a chemical spill?"></textarea>
            <div id="copilotQuestionHint" class="form-text">Answers depend on available, validated source evidence.</div>
            <span asp-validation-for="Question" class="text-danger d-block mt-1"></span>
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-primary px-4" type="submit">Ask Copilot</button>
            </div>
        </form>
    </section>

    @if (response is not null)
    {
        var statusClass = response.GroundingStatus switch
        {
            GroundingStatus.Grounded => "bg-success",
            GroundingStatus.PartiallyGrounded => "bg-warning text-dark",
            GroundingStatus.InsufficientEvidence => "bg-warning text-dark",
            GroundingStatus.SearchUnavailable => "bg-secondary",
            GroundingStatus.ValidationFailed => "bg-danger",
            _ => "bg-secondary"
        };
        <section class="er-panel p-4 mb-4" aria-labelledby="copilotAnswerHeading">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <h2 class="er-section-title" id="copilotAnswerHeading">Response</h2>
                <span class="badge @statusClass">@response.GroundingStatus</span>
            </div>
            <div class="er-copilot-answer mb-4">@response.Answer</div>

            @if (response.GroundingStatus == GroundingStatus.SearchUnavailable || response.FailureReason == CopilotFailureReason.KnowledgeUnavailable || response.FailureReason == CopilotFailureReason.ToolUnavailable || response.FailureReason == CopilotFailureReason.ModelFailure)
            {
                <div class="alert alert-warning" role="status">The Copilot response provider or source search was unavailable. Do not treat this response as verified guidance.</div>
            }
            else if (response.GroundingStatus == GroundingStatus.InsufficientEvidence || !response.SourcesSufficient)
            {
                <div class="alert alert-warning" role="note">
                    <strong>Source evidence is insufficient.</strong>
                    @if (!string.IsNullOrWhiteSpace(response.SourcesInsufficiencyReason))
                    {
                        <span>@response.SourcesInsufficiencyReason</span>
                    }
                    Do not rely on unsupported details as established procedure.
                </div>
            }
            else if (response.RequiresHumanVerification || !grounded)
            {
                <div class="alert alert-info" role="note">Human verification is required before relying on this response operationally.</div>
            }

            @if (response.Citations.Count > 0)
            {
                <div class="mb-4">
                    <h3 class="h6 fw-bold">Source citations</h3>
                    <ul class="list-group">
                        @foreach (var citation in response.Citations)
                        {
                            <li class="list-group-item">
                                <strong>@citation.DocumentNumber</strong>
                                <span> · @citation.Title · v@citation.Version · p.@citation.PageNumber</span>
                                @if (!string.IsNullOrWhiteSpace(citation.SectionHeading))
                                {
                                    <span> · @citation.SectionHeading</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(citation.CitationText))
                                {
                                    <div class="small text-muted mt-1">@citation.CitationText</div>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="alert alert-light border" role="note">No source citations were returned for this response. It has not been verified against documentation.</div>
            }

            @if (response.VerificationNotes.Count > 0)
            {
                <aside class="mb-4" aria-labelledby="copilotVerificationHeading">
                    <h3 class="h6 fw-bold" id="copilotVerificationHeading">Verification notes for this response</h3>
                    <ul class="mb-0">
                        @foreach (var note in response.VerificationNotes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </aside>
            }

            @if (response.ActionProposals.Count > 0)
            {
                <div class="border-top pt-4" aria-labelledby="copilotActionsHeading">
                    <h3 class="h5" id="copilotActionsHeading">Proposed actions</h3>
                    <p class="text-muted">These proposals are advisory. Operational state changes only through the authorized approval workflow and server-side revalidation.</p>
                    @foreach (var proposal in response.ActionProposals)
                    {
                        <article class="er-panel p-3 mb-3" data-copilot-action-id="@proposal.ProposalId">
                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                <h4 class="h6 mb-1">@proposal.ActionType</h4>
                                <span class="badge @(proposal.RequiresApproval ? "bg-warning text-dark" : "bg-secondary")">@(proposal.RequiresApproval ? "Approval required" : "Approval not required")</span>
                            </div>
                            <p class="mb-2">@proposal.Summary</p>
                            @if (proposal.ExpiresAtUtc is not null)
                            {
                                <p class="small text-muted mb-3">Expires: <time datetime="@proposal.ExpiresAtUtc.Value.ToUniversalTime().ToString("O")">@proposal.ExpiresAtUtc.Value.ToUniversalTime().ToString("u") UTC</time></p>
                            }
                            @if (proposal.RequiresApproval)
                            {
                                <div class="row g-3">
                                    <div class="col-12 col-lg-6">
                                        <form method="post" asp-action="ApproveAction" class="border rounded p-3 h-100">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="proposalId" value="@proposal.ProposalId" />
                                            <label class="form-label" for="approve-comment-@proposal.ProposalId">Approval comment (optional)</label>
                                            <input id="approve-comment-@proposal.ProposalId" type="text" name="comment" class="form-control mb-3" maxlength="500" />
                                            <button class="btn btn-primary" type="submit">Approve proposal</button>
                                        </form>
                                    </div>
                                    <div class="col-12 col-lg-6">
                                        <form method="post" asp-action="RejectAction" class="border rounded p-3 h-100">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="proposalId" value="@proposal.ProposalId" />
                                            <label class="form-label" for="reject-comment-@proposal.ProposalId">Rejection comment (optional)</label>
                                            <input id="reject-comment-@proposal.ProposalId" type="text" name="comment" class="form-control mb-3" maxlength="500" />
                                            <button class="btn btn-outline-secondary" type="submit">Reject proposal</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
</main>
